/// App Ricreo mostrate nel selettore app della sidebar.
/// Tabella condivisa: ogni app (Inventory, Print Farm, Finance, Product Console,
/// Preventivatore) può leggerla per costruire lo stesso selettore.
model RicreoApp {
  id        String  @id @default(uuid()) @db.Uuid
  /// Identificativo stabile usato dal codice (es. "inventory", "print-farm").
  slug      String  @unique
  name      String
  /// URL di apertura dell'app (origin o pagina iniziale).
  url       String
  /// Logo: URL assoluto o percorso pubblico dell'app che lo mostra (es. "/RI.svg").
  logoUrl   String?
  /// Ordine nel selettore (crescente).
  sortOrder Int     @default(0)
  /// Se false l'app non compare nel selettore.
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  access RicreoAppAccess[]

  @@schema("public")
}

/// Accesso di un utente a un'app Ricreo: decide quali app vede nel selettore.
/// Regola: il selettore mostra l'app corrente più le app attive con una riga
/// qui per l'utente collegato. Un utente senza righe vede solo l'app corrente.
/// Non è un controllo di accesso all'app: login e permessi restano quelli di
/// ciascuna app. Gestione in Inventory → Impostazioni → Generali → "App Ricreo"
/// (solo ruolo Admin).
model RicreoAppAccess {
  userId Int
  appId  String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  RicreoApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
  @@index([appId])
  @@schema("public")
}
