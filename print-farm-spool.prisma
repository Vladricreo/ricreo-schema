/// Tag fisico riutilizzabile (es. clip stampata 3D con NFC + QR code).
/// Codice univoco stampato sulla tag (es. "S001", "S002").
/// Flusso:
/// 1. Si stampano N tag con codice progressivo e si registrano nel DB.
/// 2. Quando una bobina parziale va a magazzino, si attacca una tag LIBERA.
/// 3. Scansionando QR o NFC si identifica immediatamente la spool associata.
/// 4. Quando la bobina finisce o viene rimontata, si stacca la tag → torna LIBERA.
model SpoolTag {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique /// Codice stampato sulla tag: "S001", "S002", ecc.

  nfcUid String? @unique /// UID fisico del chip NFC (opzionale, letto dal reader)

  status SpoolTagStatus @default(FREE)

  /// Spool attualmente associata (null = tag libera)
  currentSpoolId String?        @unique @db.Uuid
  currentSpool   FilamentSpool? @relation("TaggedSpool", fields: [currentSpoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Storico di tutte le associazioni passate e presente
  assignments SpoolTagAssignment[]

  /// Posizione "casa" della tag sullo spool rack (dove sta quando è libera)
  locationId String?            @db.Uuid
  location   WarehouseLocation? @relation("TagLocation", fields: [locationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([locationId])
  @@schema("print-farm")
}

enum SpoolTagStatus {
  FREE /// Disponibile, non associata a nessuna spool
  ASSIGNED /// Attualmente associata a una spool
  RETIRED /// Ritirata/rotta, non più utilizzabile

  @@schema("print-farm")
}

/// Storico delle associazioni tag ↔ spool.
/// Ogni volta che si attacca o stacca una tag, si crea/chiude un record.
model SpoolTagAssignment {
  id String @id @default(uuid()) @db.Uuid

  tagId String   @db.Uuid
  tag   SpoolTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  spoolId String        @db.Uuid
  spool   FilamentSpool @relation("TagAssignments", fields: [spoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  unassignedAt DateTime? @db.Timestamptz(6)

  @@index([tagId])
  @@index([spoolId])
  @@schema("print-farm")
}

/// Profilo tecnico di un filamento (collegato a Item di tipo MATERIAL).
/// Contiene tutte le specifiche per la stampa: temperature, codici BambuLab, etc.
model FilamentProfile {
  id String @id @default(uuid()) @db.Uuid

  // Collegamento all'Item (materiale)
  itemId String @unique @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Codici esterni per integrazione
  bambuCode String? @unique // Es. "GFA00", "GFB00", "GFL99"

  // Temperature di stampa (°C)
  printTempMin Int? // Es. 190
  printTempMax Int? // Es. 220
  bedTempMin   Int? // Es. 45
  bedTempMax   Int? // Es. 60

  // Essiccazione
  dryingTemp                    Int? // Es. 55
  dryingTimeHours               Int? // Es. 8
  dryingPolicy                  FilamentDryingPolicy @default(NONE) // Policy esplicita: distinta dal vincolo sul percorso di stampa
  dryingFreshnessHours          Int? // Validità dell'asciugatura completata; null usa il default scheduler
  warnDryOpenedSpoolBeforePrint Boolean              @default(false) // Avvisa se una bobina aperta va asciugata prima della stampa
  requireHeatedAmsForPrint      Boolean              @default(false) // Usa dryingTemp per distinguere AMS 2 Pro (<=65°C) e AMS HT (<=85°C)
  requireAmsHtForPrint          Boolean              @default(false) // Vincolo esplicito: stampa esclusivamente tramite AMS HT

  // Riscaldamento mantenuto durante la stampa (non e' un ciclo di asciugatura):
  // il backend lo avvia allo start sull'unita' che alimenta la stampa.
  keepAmsHeatedDuringPrint Boolean @default(false)
  amsHeatDuringPrintTempC  Int? // Temperatura mantenuta durante la stampa (<=65°C su AMS 2 Pro, <=85°C su AMS HT)

  // Proprietà fisiche
  density  Decimal? @db.Decimal(5, 3) // g/cm³ per calcolo peso
  diameter Decimal  @default(1.75) @db.Decimal(4, 2) // mm

  // Compatibilità
  compatibleNozzles String[] // Es. ["Standard", "Hardened Steel"]

  // Velocità consigliate
  maxVolumetricSpeed Decimal? @db.Decimal(6, 2) // mm³/s

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("print-farm")
}

/// Policy di asciugatura del materiale prima della stampa.
/// Non descrive il percorso di alimentazione: `requireAmsHtForPrint` resta un vincolo separato.
enum FilamentDryingPolicy {
  NONE
  RECOMMENDED
  REQUIRED

  @@schema("print-farm")
}

/// Rappresenta una bobina fisica (o virtuale) di filamento.
/// UTILIZZO "SLOT VIRTUALE" (Consigliato per alti volumi):
/// 1. Quando si carica una bobina NUOVA, si crea un FilamentSpool con isVirtual=true e weight=1000g.
/// 2. Non serve etichettare la bobina fisica. L'ID esiste solo nel database associato alla stampante.
/// 3. Ogni stampa scala il peso da questa bobina.
/// 4. Quando finisce o viene rimossa (senza essere finita), si marca come ARCHIVED.
///    Se rimossa parzialmente e si vuole riusare: solo allora si etichetta fisicamente e si tiene isVirtual=false.
model FilamentSpool {
  id String @id @default(uuid()) @db.Uuid

  itemId String @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Il tipo di materiale (es. PLA Nero)

  // Tracciamento Peso
  initialWeight   Decimal @db.Decimal(10, 2) // Peso netto iniziale (es. 1000g)
  remainingWeight Decimal @db.Decimal(10, 2) // Peso stimato residuo

  // Stato
  isVirtual Boolean     @default(true) // True = Nessuna etichetta fisica, esiste solo "montata" sulla stampante
  status    SpoolStatus @default(ACTIVE)

  // Tracciabilità
  lotCode        String? // Lotto del produttore (facoltativo, per qualità ISO)
  /// Lotto di inventario associato a questa bobina (acquisto o produzione interna).
  /// Permette di risalire al fornitore o al lotto di produzione anche via spool.
  inventoryLotId String?       @db.Uuid
  inventoryLot   InventoryLot? @relation("InventoryLotFilamentSpools", fields: [inventoryLotId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Tag fisica riutilizzabile associata (relazione inversa da SpoolTag)
  tag            SpoolTag?            @relation("TaggedSpool")
  tagAssignments SpoolTagAssignment[] @relation("TagAssignments")

  openedAt    DateTime  @default(now()) @db.Timestamptz(6) // Per scadenza/umidità
  /// Ultima asciugatura confermata/osservata.
  /// Il default coincide con l'apertura: una bobina sigillata appena aperta è
  /// già asciutta per tutta la finestra di validità del materiale.
  lastDriedAt DateTime? @default(now()) @db.Timestamptz(6)
  /// Quando valorizzato, l'orologio di validità è fermo: la bobina è in una AMS
  /// che asciuga (HT / 2 Pro). Si azzera e si sposta `lastDriedAt` in avanti
  /// quando torna in rack o in un'AMS senza asciugatura.
  freshnessPausedAt DateTime? @db.Timestamptz(6)
  finishedAt  DateTime? @db.Timestamptz(6)

  // Dove si trova?
  mountedOnId String?  @db.Uuid // ID Stampante se montata
  mountedOn   Printer? @relation("MountedSpool", fields: [mountedOnId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  activeOnPrinters Printer[] @relation("ActiveSpool")

  printRuns PrintRun[] // Storico stampe fatte con questa bobina

  /// Operazioni di carico filamento in cui è stata usata questa bobina
  filamentLoads PrinterFilamentLoad[]

  /// Posizione in magazzino (quando non montata su stampante).
  /// Usata per bobine parziali stoccate in attesa di riutilizzo.
  locationId String?            @db.Uuid
  location   WarehouseLocation? @relation("SpoolLocation", fields: [locationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Slot AMS in cui è caricata questa spool (per stampanti con AMS).
  /// Se presente, indica che la spool è in uno slot AMS specifico.
  amsSlot PrinterAmsSlot? @relation("AmsSlotSpool")

  /// Spool esterna (`vt_tray`) montata su un nozzle. Per single-nozzle è il `currentSpool` legacy.
  /// Per dual-nozzle, distingue Right (extruderId=0) e Left (extruderId=1).
  externalSpool PrinterExternalSpool? @relation("ExternalSpool")

  /// Righe di piano scheduler che useranno questa bobina.
  assignmentSpoolPlans  AssignmentSpoolPlan[]  @relation("AssignmentSpoolPlans")
  /// Cicli JIT pianificati per questa bobina fisica.
  assignmentDryingPlans AssignmentDryingPlan[] @relation("DryingPlanSpool")
  /// Cicli di asciugatura avviati sulla bobina (non legati a un assignment).
  dryingSessions        SpoolDryingSession[]   @relation("SpoolDryingSessions")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([inventoryLotId])
  @@index([locationId])
  /// Hot path picker/compatible-spools: filtra per item e join su magazzino.
  @@index([itemId])
  /// Hot path unmount/mount: cerca spool montate su una stampante.
  @@index([mountedOnId])
  /// Hot path partial disponibili: ACTIVE + non montate + peso residuo.
  @@index([status, mountedOnId, remainingWeight])
  @@schema("print-farm")
}

enum SpoolStatus {
  ACTIVE // In uso o pronta all'uso
  DEPLETED // Finita (0g o scarto)
  ARCHIVED // Rimossa e non più tracciata (es. buttata parziale o persa)

  @@schema("print-farm")
}

/// Tipo di risorsa trattenuta dal piano di preparazione live.
enum PreparationReservationKind {
  SPOOL
  UNLOAD_LOCATION
  AMS_SLOT

  @@schema("print-farm")
}

/// Lock leggero e temporaneo del piano di preparazione.
/// Le relazioni restano scalari per poter prenotare anche inventory sigillato
/// senza creare una FilamentSpool prima dell'apertura fisica.
model PreparationReservation {
  id String @id @default(uuid()) @db.Uuid

  spoolId    String? @unique @db.Uuid
  locationId String? @unique @db.Uuid
  amsSlotId  String? @unique @db.Uuid

  printerId    String  @db.Uuid
  assignmentId String? @db.Uuid
  kind         PreparationReservationKind
  expiresAt    DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([printerId, expiresAt])
  @@index([assignmentId, expiresAt])
  @@index([expiresAt])
  @@schema("print-farm")
}

/// Slot AMS di una stampante.
/// Ogni stampante con AMS può avere fino a 4 unità (A-D), ciascuna con 4 slot (1-4).
/// Questo model traccia quale spool è caricata in ogni slot.
model PrinterAmsSlot {
  id String @id @default(uuid()) @db.Uuid

  /// Stampante a cui appartiene lo slot
  printerId String  @db.Uuid
  printer   Printer @relation("PrinterAmsSlots", fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Unità AMS (0-3 = A, B, C, D)
  amsUnit Int

  /// Slot all'interno dell'unità (0-3 = slot 1-4)
  slot Int

  /// Spool attualmente caricata in questo slot (null = slot vuoto)
  /// @unique perché una spool può stare in un solo slot AMS alla volta
  spoolId String?        @unique @db.Uuid
  spool   FilamentSpool? @relation("AmsSlotSpool", fields: [spoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// FK opzionale al nuovo `PrinterAmsUnit` (popolata durante la migrazione di backfill).
  /// Resta nullable per back-compat: i consumer legacy possono ancora navigare via (printerId, amsUnit).
  amsUnitId  String?         @db.Uuid
  amsUnitRel PrinterAmsUnit? @relation("AmsUnitSlots", fields: [amsUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Snapshot "reported" dalla stampante (NON tracciamento spool).
  /// Serve per salvare materiale/colore anche quando non abbiamo una FilamentSpool assegnata.
  /// Non deve sovrascrivere la spool "reale" (spoolId) scelta dal frontend.
  reportedMaterialType String? // es. "PLA", "ABS", "PETG"
  reportedColor        String? // es. "BLACK", "RED", "#FF0000" (best-effort)
  reportedTrayInfoIdx  String? // es. "GFB99" (Bambu tray_info_idx) - opzionale
  reportedLastSeenAt   DateTime? @db.Timestamptz(6)

  /// Reservation source-of-truth opzionale; il vincolo unique è sulla riga piano.
  spoolPlanReservation  AssignmentSpoolPlan?   @relation("SpoolPlanReservedSlot")
  /// Cicli JIT che richiedono la spool fisica in questo slot.
  assignmentDryingPlans AssignmentDryingPlan[] @relation("DryingPlanAmsSlot")
  /// Cicli JIT che, a fine asciugatura, richiedono la spool trasferita qui.
  dryingRelocations     AssignmentDryingPlan[] @relation("DryingPlanRelocationSlot")
  /// Cicli di asciugatura bobina avviati su questo slot.
  dryingSessions        SpoolDryingSession[]   @relation("SpoolDryingSessionSlot")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  /// Un solo record per combinazione stampante + unità + slot
  @@unique([printerId, amsUnit, slot])
  @@index([printerId])
  @@index([spoolId])
  @@index([amsUnitId])
  @@schema("print-farm")
}

/// Stato di un ciclo di asciugatura avviato su una bobina specifica.
enum SpoolDryingSessionStatus {
  DRYING
  COMPLETED
  STOPPED
  FAILED

  @@schema("print-farm")
}

/// Origine del ciclo di asciugatura bobina.
enum SpoolDryingTrigger {
  /// Avviato dall'operatore dalla pagina di preparazione.
  MANUAL
  /// Avviato in automatico insieme all'invio delle stampe (asciuga mentre stampa).
  PRINT_START

  @@schema("print-farm")
}

/// Ciclo di asciugatura legato alla **bobina fisica**, non a un assignment.
///
/// Complementare a `AssignmentDryingPlan` (asciugatura JIT pianificata dallo
/// scheduler): qui l'operatore mette la bobina nella AMS HT e avvia il ciclo
/// quando vuole. Mentre la sessione è `DRYING` l'unità AMS risulta occupata e
/// non viene proposta per altri materiali, ma la stampante può continuare a
/// stampare usando le altre unità.
///
/// Il completamento arriva dalla telemetria backend (`/api/internal/drying-events`)
/// e aggiorna `FilamentSpool.lastDriedAt`, da cui deriva la validità.
model SpoolDryingSession {
  id String @id @default(uuid()) @db.Uuid

  spoolId String        @db.Uuid
  spool   FilamentSpool @relation("SpoolDryingSessions", fields: [spoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  printerId String  @db.Uuid
  printer   Printer @relation("PrinterSpoolDryingSessions", fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  amsUnitId String         @db.Uuid
  amsUnit   PrinterAmsUnit @relation("AmsUnitSpoolDryingSessions", fields: [amsUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  amsSlotId String         @db.Uuid
  amsSlot   PrinterAmsSlot @relation("SpoolDryingSessionSlot", fields: [amsSlotId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status  SpoolDryingSessionStatus @default(DRYING)
  trigger SpoolDryingTrigger       @default(MANUAL)

  /// Parametri effettivi del ciclo, risolti dal profilo filamento al momento dell'avvio.
  tempC           Int
  durationMinutes Int
  freshnessHours  Int
  /// Materiale inviato nel comando MQTT (`ams_filament_drying.filament`).
  filamentLabel   String?

  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  /// Fine prevista del ciclo: base della barra di progresso lato UI.
  expectedEndAt DateTime  @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  stoppedAt     DateTime? @db.Timestamptz(6)
  /// Valorizzato al completamento: `completedAt + freshnessHours`.
  freshnessUntil DateTime? @db.Timestamptz(6)

  /// Identità del comando verso il backend: blocca callback stale/duplicate.
  commandIdempotencyKey String @unique

  failureReason String?
  /// Operatore che ha avviato il ciclo (scalare: nessuna FK verso lo schema auth).
  operatorUserId Int?

  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([spoolId, startedAt(sort: Desc)])
  @@index([printerId, status])
  @@index([amsUnitId, status])
  @@index([status, startedAt(sort: Desc)])
  @@schema("print-farm")
}
