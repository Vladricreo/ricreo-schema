/// Tipo di superficie piatto richiesta dal file / montata sulla stampante (Bambu Studio / firmware).
enum PlateType {
  TEXTURED
  SMOOTH
  SMOOTH_PA

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("plate_type")
  @@schema("public")
}

/// File di progetto 3MF per la stampa 3D.
/// Include informazioni sul file, parametri di stampa, materiali usati e versionamento.
model ProjectThreeMFFile {
  id                       String   @id @default(uuid()) @db.Uuid
  filename                 String
  filepath                 String
  filesize                 Decimal  @db.Decimal(12, 3)
  projectName              String
  skus                     Sku[]    @relation("ProjectRelatedSku")
  imageUrl                 String   @default("")
  estimatedDurationMinutes Int // tempo stimato in minuti
  compatiblePrinters       String[] // nomi stampanti compatibili
  zHeight                  Decimal  @db.Decimal(12, 2) // altezza modello in mm
  nozzleDiameter           Decimal  @db.Decimal(4, 2) // diametro ugello in mm
  nozzleType               String   @default("Standard") // tipo ugello richiesto dal file
  partCount                Int // numero di parti nel plate
  totalLayers              Int // numero di strati
  totalFilamentWeight      Decimal? @db.Decimal(12, 2) // peso totale filamento usato in grammi
  plateNumber              Int      @default(1) // Numero del plate (index) per il comando di stampa

  /// Tipo piatto richiesto per questa stampa (filtraggio stampanti + `bed_type` su comando Bambu).
  requiredPlateType PlateType @default(TEXTURED)

  /// Metadati estratti da `Metadata/slice_info.config` (Bambu Studio)
  printerModelId String? // es. "C12"
  supportsUsed   Boolean @default(false)
  objectCount    Int     @default(0) // numero <object skipped="false" />
  /// Oggetti nel plate (per skip/selezione oggetti singoli in stampa)
  /// JSON array: [{ identifyId: number, name: string, skipped: boolean }]
  sliceObjects   Json?

  /// --- PROFILO DI SLICING (multi-nozzle) — cfr. docs/multi-nozzle §13 ---
  /// Classificazione derivata da `Metadata/slice_info.config` (`filament_maps`).
  /// 'SINGLE' = tutti i filamenti su un solo extruder; 'DUAL' = >=2 extruder distinti.
  /// Null per file legacy senza `filament_maps`.
  nozzleMode                String?
  /// Extruder a cui è "pinnato" un file SINGLE (es. tutto su left). Null = ext0/legacy.
  pinnedExtruder            Int?
  /// Modalità mappa filamenti del file ('MANUAL' | 'AUTO' | 'DYNAMIC').
  sliceMapMode              String?
  /// True se il file è stato affettato assumendo l'FTS (`has_filament_switcher`).
  fileExpectsFts            Boolean?
  /// Tipo hardware per-extruder (`extruder_type`, ordine per indice extruder 0,1,...).
  extruderTypes             Int[]     @default([])
  /// Diametri nozzle per-extruder (`nozzle_diameters`, ordine per indice extruder 0,1,...).
  nozzleDiametersByExtruder Decimal[] @default([]) @db.Decimal(4, 2)

  /// Il file richiede un intervento manuale a metà stampa (es. inserimento di un componente/inserto)
  /// che causa una pausa attesa/pianificata. Usato per mostrare all'operatore un messaggio dedicato
  /// ("Pausa per inserimento aggiuntivo") alla prima pausa rilevata per questa stampa, invece del
  /// generico "In pausa".
  requiresAdditionalInsert Boolean @default(false)

  /// Percentuale di riempimento del piano (es. 0.70 = 70%)
  /// Usata per stimare l'area delle parti quando non conosciamo le dimensioni esatte
  plateFillPercentage Decimal @default(0.70) @db.Decimal(3, 2)

  // Versionamento
  version   Int        @default(1)
  status    FileStatus @default(DRAFT)
  changeLog String? // Es. "Aumentato riempimento al 20%"

  // Self-relation per tracciare la storia delle versioni (v2 -> v1)
  previousVersionId String?             @unique @db.Uuid
  previousVersion   ProjectThreeMFFile? @relation("FileHistory", fields: [previousVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nextVersion       ProjectThreeMFFile? @relation("FileHistory")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  printRuns             PrintRun[]
  schedulerCalibrations SchedulerCalibration[]
  productId             String?                @db.Uuid
  product               Product?               @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Parte principale associata al file (opzionale).
  /// Nota: il dettaglio multi-parte rimane in `ProjectPart`, ma questo campo serve per risoluzioni rapide e affidabili.
  productPartId         String?                @db.Uuid
  productPart           ProductPart?           @relation("ProductPartFiles", fields: [productPartId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  materials             Item[] // Relazione legacy (per compatibilità)
  fileMaterials         ProjectFileMaterial[] // Nuova relazione con peso specifico del file
  productionJobs        ProductionJob[]        @relation("JobsToFiles")
  parts                 ProjectPart[]          @relation("ProjectParts")
  feedbacks             FarmFeedback[]

  /// Task di accodamento persistenti (flusso "send to print")
  queueTasks QueueTask[] @relation("FileQueueTasks")

  /// Job di slicing che hanno prodotto questo file (inverso di `SliceJob.resultFile`).
  sliceJob SliceJob? @relation("SliceJobResultFile")

  @@index([productId])
  @@index([productPartId])
  @@index([status])
  @@index([previousVersionId])
  @@schema("print-farm")
}

/// Relazione tra file 3MF e materiali con peso specifico usato nel file.
/// I grammi sono specifici del file, non dell'anagrafica materiali.
model ProjectFileMaterial {
  id String @id @default(uuid()) @db.Uuid

  fileId String             @db.Uuid
  file   ProjectThreeMFFile @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Indice del filamento *nel 3MF* (0-based).
  /// Corrisponde alla posizione del filamento nell'elenco estratto da `Metadata/slice_info.config`
  /// (es. `fileFilaments[*].fileFilamentIndex`) e serve per ricostruire correttamente il mapping AMS/tray.
  fileFilamentIndex Int     @default(1)
  /// ID filamento in slice_info.config (spesso 1-based, string)
  fileFilamentId    String?
  /// tray_info_idx (es. GFB99)
  trayInfoIdx       String?
  /// Tipo filamento nel file (PLA/ABS/...)
  filamentType      String?
  /// Extruder dichiarato dal file Bambu Studio (0 = right/main, 1 = left/auxiliary).
  /// Estratto da `Metadata/slice_info.config` (`filament_maps`). Null se single-nozzle o non specificato.
  extruderId        Int?

  /// Materiale inventario associato (opzionale, può essere mappato successivamente)
  materialId String? @db.Uuid
  material   Item?   @relation("FileMaterialUsage", fields: [materialId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  usedWeight Decimal @db.Decimal(12, 2) // Grammi usati nel file (per quel filamento)
  colorUsed  String? // Colore usato (tipicamente il colore del filamento nel file)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([fileId, fileFilamentIndex]) // Un filamento (indice) una sola volta per file
  @@index([fileId])
  @@index([materialId])
  @@schema("print-farm")
}

/// Rappresenta una parte nel file 3MF collegata a una ProductPart del prodotto.
/// Traccia la quantità di parti nel file e il peso calcolato per singola parte.
model ProjectPart {
  id               String   @id @default(uuid()) @db.Uuid
  quantity         Int      @default(0) // Quantità di parti nel file 3MF
  weight           Decimal? @db.Decimal(12, 2) // Peso calcolato per singola parte (totalWeight / quantity)
  imageFromFileUrl String? // URL immagine estratta dal file 3MF

  productPartId String?      @db.Uuid
  productPart   ProductPart? @relation(fields: [productPartId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  fileId String             @db.Uuid
  file   ProjectThreeMFFile @relation("ProjectParts", fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productionJobs ProductionJob[] @relation("ProductionJobParts")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([productPartId])
  @@index([productId])
  @@index([fileId])
  @@schema("print-farm")
}

/// Job di stampa 3D per una specifica parte.
/// Collegato a un ProductOrder (ordine di produzione dall'inventario).
/// Ogni ProductionJob produce N pezzi di una singola parte usando un file 3MF.
model ProductionJob {
  id                 String               @id @default(uuid()) @db.Uuid
  /// Progressivo numerico leggibile (BIGINT Postgres) per uso umano/reportistica.
  /// Nota: lasciamo `id` UUID come PK per non rompere relazioni/migrazioni; questo è solo un numero sequenziale.
  number             BigInt               @unique @default(autoincrement()) @db.BigInt
  priority           Int                  @default(1) // 1=low, 2=medium, 3=high, 4=critical
  assignedPrinterIds String[]
  estimatedTime      Decimal?             @db.Decimal(12, 2) // Tempo stimato in minuti
  eta                DateTime?            @db.Timestamptz(6)
  startedAt          DateTime?            @db.Timestamptz(6)
  finishedAt         DateTime?            @db.Timestamptz(6)
  status             FarmProductionStatus @default(READY_TO_PRODUCE)
  quantity           Int // Quantità totale da produrre
  quantityPrinted    Int                  @default(0) // Pezzi stampati con successo
  quantityFailed     Int                  @default(0) // Pezzi falliti/scartati
  notes              String? // Note operative

  // Relazioni con file e parti
  files     ProjectThreeMFFile[] @relation("JobsToFiles")
  printRuns PrintRun[]
  parts     ProjectPart[]        @relation("ProductionJobParts")
  filaments Item[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Collegamento al Prodotto
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Collegamento alla Parte specifica del prodotto
  productPartId String?      @db.Uuid
  productPart   ProductPart? @relation(fields: [productPartId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Collegamento all'Ordine di Produzione (dall'inventario)
  productOrderId String?       @db.Uuid
  productOrder   ProductOrder? @relation("ProductOrderJobs", fields: [productOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Collegamento logico all'AssemblyOrder che ha generato questo job (cron).
  /// È un campo di tracking: non è una relazione Prisma perché `AssemblyOrder` vive nello schema "inventory".
  assemblyOrderId String? @db.Uuid

  // Collegamento al Lotto di Produzione (per tracciabilità ISO)
  productionLotId String?        @db.Uuid
  productionLot   ProductionLot? @relation(fields: [productionLotId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  powerConsumed Decimal? @db.Decimal(12, 3) // Consumo energia in kWh

  // Odette assegnate per lo scarico pezzi (pre-assegnate all'avvio del job)
  odettes Odette[]

  /// Assegnazioni stampanti per questo job
  printerAssignments PrinterAssignment[]

  /// Task di accodamento persistenti (flusso "send to print")
  queueTasks QueueTask[] @relation("JobQueueTasks")

  failureLogs PrintFailureLog[]

  /// Task Gantt che coinvolgono questo job
  ganttTasks GanttTask[]

  /// Segnalazioni sui file rilevate durante questo job.
  feedbacks FarmFeedback[]

  @@unique([productOrderId, productPartId])
  @@index([productOrderId])
  @@index([assemblyOrderId])
  @@index([productId])
  @@index([productPartId])
  @@index([status])
  /// Hot path tracciabilità ISO: risalire dai job al lotto di produzione.
  @@index([productionLotId])
  @@schema("print-farm")
}

model PrintRun {
  id               String    @id @default(uuid()) @db.Uuid
  /// Progressivo numerico leggibile (BIGINT Postgres) per uso umano/reportistica.
  /// Nota: lasciamo `id` UUID come PK per non rompere relazioni/migrazioni; questo è solo un numero sequenziale.
  number           BigInt    @unique @default(autoincrement()) @db.BigInt
  startedAt        DateTime? @db.Timestamptz(6)
  finishedAt       DateTime? @db.Timestamptz(6)
  /// Quantità attesa/target per questa singola run.
  /// Utile per run con "skip oggetti" (es. completamento job) e per audit/metriche.
  expectedQuantity Int?

  /// Stampante associata a questa run.
  ///
  /// OBBLIGATORIO per tracciabilità ISO: le view inventario (`v_lot_upstream_material`,
  /// `v_lot_timeline_events`) leggono `PrintRun.printerId` direttamente — non via assignment.
  /// Valorizzare SEMPRE anche sulle run pianificate (oltre ad `assignmentId`), altrimenti
  /// il nome stampante non compare nella timeline del lotto. Utile anche per run unplanned/custom
  /// senza `PrinterAssignment`.
  printerId String?  @db.Uuid
  printer   Printer? @relation("PrintRunPrinter", fields: [printerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Assegnazione stampante (PrinterAssignment) che ha generato/gestito questa run.
  /// Serve a legare l'esecuzione reale (run) al workflow operativo (assignment).
  assignmentId String?            @db.Uuid
  assignment   PrinterAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  productionJob   ProductionJob? @relation(fields: [productionJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productionJobId String?        @db.Uuid

  /// File stampato, se noto e presente nel sistema.
  ///
  /// Nota: per supportare run “unplanned/custom” rendiamo `fileId` opzionale: in quel caso useremo `taskFileName`
  /// (nome file riportato dalla stampante) finché non riusciamo a risolvere/mappare un `ProjectThreeMFFile`.
  filePrinted ProjectThreeMFFile? @relation(fields: [fileId], references: [id])
  fileId      String?             @db.Uuid

  /// Identificativo task runtime riportato dalla stampante (NON unico globalmente: può ripetersi tra stampanti e nel tempo).
  /// Va sempre interpretato insieme a `printerId`/`assignment` e ad un timestamp di osservazione (`detectedAt`).
  taskId Int? @db.SmallInt

  /// Nome file riportato dalla stampante (es. `.3mf` o `.gcode`) anche se non presente come `ProjectThreeMFFile`.
  taskFileName String?

  /// Timestamp lato server della prima osservazione (firstSeen) di questa run/task tramite WSS/MQTT.
  /// Non è lo "startedAt" della stampante: serve solo per disambiguare `taskId` riusati nel tempo.
  detectedAt DateTime? @db.Timestamptz(6)

  /// Origine della run (UI, stampante, ecc.) per audit e riconciliazione.
  source PrintRunSource @default(UI)

  printTimeMinutes   Decimal?       @db.Decimal(12, 2)
  powerConsumed      Decimal?       @db.Decimal(12, 3)
  energyCostSnapshot Decimal?       @db.Decimal(12, 2) // Costo energia al momento della stampa
  quantitySuccess    Int            @default(0)
  quantityFailed     Int            @default(0)
  status             PrintRunStatus @default(PENDING)
  /// Percentuale di completamento al termine della run (0-100). Salvato alla finalizzazione (COMPLETED/FAILED).
  completionPercent  Int?           @db.SmallInt
  filaments          Item[]
  spoolId            String?        @db.Uuid // Bobina usata per questa run
  spool              FilamentSpool? @relation(fields: [spoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  notes              String?

  failureLogs PrintFailureLog[]

  /// Metriche aggiuntive per questa run (consumo filamento, scarto)
  metrics PrintRunMetrics?

  /// Telemetria (opzionale) correlata a questa run:
  /// - eventi di cambio stato (quando si riesce a determinare printRunId)
  /// - eventi di downtime correlati
  stateEvents    PrinterStateEvent[]    @relation("PrintRunStateEvents")
  downtimeEvents PrinterDowntimeEvent[] @relation("PrintRunDowntimeEvents")

  /// Operazioni di raccolta pezzi associate a questa run.
  /// Utile specialmente per run unplanned/manuali dove l'assignment potrebbe non essere significativa.
  harvests PrinterHarvest[]

  /// Task di accodamento che ha generato questa run (se presente)
  queueTask QueueTask? @relation("QueueTaskPrintRun")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([printerId])
  @@index([printerId, taskId])
  @@index([assignmentId])
  @@index([productionJobId])
  @@index([fileId])
  @@index([spoolId])
  @@index([status])
  @@index([startedAt])
  @@schema("print-farm")
}

/// Origine/contesto con cui è stata generata una PrintRun.
/// Utile per distinguere run “pianificate” dall'app vs run avviate direttamente dalla stampante o da processi automatici.
enum PrintRunSource {
  UI
  PRINTER
  SYSTEM

  @@schema("print-farm")
}

model Printer {
  id     String       @id @default(uuid()) @db.Uuid
  serial String? // Serial number BambuLab (es. 00M09C433002451)
  name   String
  brand  PrinterBrand @default(BAMBU_LAB)

  model   PrinterModel @relation(fields: [modelId], references: [id])
  modelId Int

  imageUrl                 String?
  ipAddress                String?
  softwareType             SoftwareType @default(BAMBU_STUDIO)
  accessCode               String?
  apiKey                   String?
  peakPower                Decimal?     @db.Decimal(12, 2)
  runPower                 Decimal?     @db.Decimal(12, 2)
  nozzleDiameter           Decimal      @default(0.4) @db.Decimal(4, 2)
  nozzleType               String       @default("Hardened Steel")
  /// Numero di nozzle/extruder della stampante (1 = single, 2 = dual H2D/X2D).
  /// Autodetect dal firmware; fallback a 1 per back-compat.
  nozzleCount              Int          @default(1)
  /// True se la stampante ha il Filament Track Switch installato (solo dual-nozzle).
  /// Quando true, ogni AMS può alimentare entrambi i nozzle (routing dinamico).
  filaTrackSwitchInstalled Boolean      @default(false)
  /// Snapshot dell'ultimo stato `fila_switch` riportato dal firmware (per debug + UI).
  filaTrackSwitchState     Json?
  /// Ultimo extruder attivo riportato dalla stampante (0 = right/main, 1 = left/auxiliary).
  activeExtruder           Int          @default(0)
  /// Tipo piatto attualmente montato (aggiornamento manuale operatore; usato per compatibilità con i file).
  currentPlateType         PlateType    @default(TEXTURED)
  /// True se la stampante ha il modulo per stampare TPU/TPE installato.
  /// La compatibilità è per-stampante (non per modello): alcune macchine hanno il modulo, altre no.
  /// Quando false, lo scheduler non assegna a questa stampante job con materiale TPU/TPE.
  supportsTpu              Boolean      @default(false)
  structure                String       @default("CoreXY")
  ams                      Boolean?
  /// Modello AMS collegato (se presente). Serve per stimare consumi AMS (standby/working/drying).
  amsModel                 AmsModel?
  pushAllTimeout           Int?

  /// Stato runtime dalla stampante (WebSocket) - volatile
  status PrinterStatus @default(OFFLINE)

  /// Stato operativo (persistente) usato dalla UI e dalla logica applicativa.
  /// Consiglio: evitare di "scriverlo" in tanti punti diversi. Meglio calcolarlo con una funzione
  /// deterministica che combina: override manuale + issue attive + assignment/coda + stato WSS.
  operationalStatus PrinterOperationalStatus @default(AVAILABLE)

  /// True quando serve cambio filamento (colore/materiale) per poter far partire il prossimo job.
  /// È un flag persistente “overlay” separato da `operationalStatus` per evitare conflitti.
  needsFilamentSwap Boolean @default(false)

  /// Istante in cui il flag è passato a true: serve per misurare il tempo di reazione
  /// dell'operatore (attesa stampante) nelle sessioni di cambio filamento.
  /// Non viene rinfrescato se il flag era già true.
  needsFilamentSwapAt DateTime? @db.Timestamptz(6)

  /// True quando il piatto è *attivamente* in riscaldamento verso il target (indipendente da operationalStatus).
  /// Viene aggiornato dal backend in base a `bedTemp` e `bedTargetTemp` con isteresi (evita toggle rapido).
  isBedHeating Boolean @default(false)

  /// --- ULTIMO JOB (PERSISTENZA "REPRINT") ---
  /// Questi campi vengono aggiornati dal backend quando parte una stampa, per permettere
  /// la funzione di reprint anche dopo un riavvio del backend.
  lastPrintFilename    String?
  lastPrintPlateNumber Int?
  lastPrintUseAms      Boolean?
  /// Mapping AMS dell'ultimo job (5 elementi, best-effort). Può essere NULL se non determinabile.
  lastPrintAmsMapping  Int[]
  /// Mapping per-filamento → extruderId dell'ultimo job (solo dual-nozzle). Parallelo a `lastPrintAmsMapping`.
  lastPrintFilamentMap Int[]
  lastPrintAt          DateTime? @db.Timestamptz(6)

  /// --- HEALTH / TELEMETRIA ---
  /// Ultimo aggiornamento ricevuto dalla stampante via WebSocket.
  lastWssAt  DateTime? @db.Timestamptz(6)
  /// Ultimo aggiornamento ricevuto via MQTT (errori/eventi).
  lastMqttAt DateTime? @db.Timestamptz(6)

  /// --- OVERRIDE MANUALE (OPERATORE) ---
  /// Override esplicito impostato dall'operatore (es. MAINTENANCE/DISABLED).
  /// Se presente, deve avere precedenza sullo stato derivato.
  manualOverrideStatus PrinterManualOverrideStatus?
  manualOverrideReason String?
  /// User ID (stringa) che ha impostato l'override (evita vincoli cross-schema).
  manualOverrideBy     String?
  manualOverrideAt     DateTime?                    @db.Timestamptz(6)

  /// --- STATO PIATTO / SCARICO ---
  /// True quando il piatto ha una stampa completata/terminata e richiede scarico pezzi.
  /// È un flag persistente “overlay” separato da `operationalStatus` per evitare conflitti.
  hasCompletedPrintOnBed             Boolean            @default(false)
  hasCompletedPrintOnBedAt           DateTime?          @db.Timestamptz(6)
  /// Assignment che attualmente "occupa" il piatto (se noto).
  hasCompletedPrintOnBedAssignmentId String?            @unique @db.Uuid
  hasCompletedPrintOnBedAssignment   PrinterAssignment? @relation("BedOccupiedAssignment", fields: [hasCompletedPrintOnBedAssignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Posizione fisica della stampante nella print farm (fila/slot di magazzino).
  locationId String?            @db.Uuid
  location   WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Gestione Preferenze e Assegnazione
  currentMaterialId String?        @db.Uuid // ID dell'Item (filamento) attualmente caricato
  currentSpoolId    String?        @db.Uuid // ID della bobina (Virtuale o Fisica) attualmente montata
  currentSpool      FilamentSpool? @relation("ActiveSpool", fields: [currentSpoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Snapshot "reported" dalla stampante per la spool esterna (NON tracciamento spool).
  /// Serve a salvare materiale/colore visto dalla stampante anche se:
  /// - non abbiamo ancora creato/assegnato una FilamentSpool tracciata
  /// - il frontend decide di assegnare una spool/materiale diverso (questi campi restano separati)
  externalReportedMaterialType String? // es. "PLA", "ABS", "PETG"
  externalReportedColor        String? // es. "BLACK", "RED", "#FF0000" (best-effort)
  externalReportedTrayInfoIdx  String? // se disponibile (Bambu tray_info_idx)
  externalReportedLastSeenAt   DateTime? @db.Timestamptz(6)

  /// Incongruenza fra filamento "reported" dalla stampante e spool tracciata nel DB.
  /// Settato dal backend WSS quando rileva che il materiale/colore riportato dal firmware
  /// non corrisponde alla spool associata (currentSpool o AMS slot).
  hasFilamentMismatch        Boolean   @default(false)
  filamentMismatchDetectedAt DateTime? @db.Timestamptz(6)
  filamentMismatchDetails    Json?     @db.JsonB

  /// Categorie materiali preferite per questa stampante (relazione M2M con Category filtrate per ItemType.MATERIAL).
  /// Serve per suggerire automaticamente l'assegnazione dei job in base al materiale richiesto.
  preferredMaterialCategories PrinterPreferredMaterialCategory[]

  logs             PrinterLogs[]
  maintenanceLogs  PrinterMaintenanceLog[]
  /// Periodi di override (manutenzione / disabilitata / stampa manuale) con ingresso e uscita.
  overridePeriods  PrinterOverridePeriod[]
  /// Piani di manutenzione ricorrente associati alla stampante (template ISO).
  maintenancePlans PrinterMaintenancePlan[]
  feedbacks        FarmFeedback[]
  /// Issue operative/tecniche aperte o risolte (derivate da MQTT/WSS o inserite manualmente).
  issues           PrinterIssue[]

  printerMacros PrinterMacro[]    @relation("PrinterCompatibility")
  failureLogs   PrintFailureLog[]
  spools        FilamentSpool[]   @relation("MountedSpool")

  /// Assegnazioni job a questa stampante (coda di lavoro)
  assignments PrinterAssignment[]

  /// PrintRun collegate direttamente a questa stampante (supporto run "unplanned/custom").
  /// Relazione separata da `assignments -> printRuns` quindi deve essere nominata.
  printRuns PrintRun[] @relation("PrintRunPrinter")

  /// Storico raccolte pezzi da questa stampante
  harvests      PrinterHarvest[]
  /// Storico carichi filamento su questa stampante
  filamentLoads PrinterFilamentLoad[]
  /// Sessioni cronometrate di cambio/ricarica filamento su questa stampante
  swapSessions  FilamentSwapSession[]

  /// Slot AMS per stampanti con AMS.
  /// Ogni slot può contenere una spool. Per stampanti senza AMS, usare currentSpoolId.
  amsSlots PrinterAmsSlot[] @relation("PrinterAmsSlots")

  /// Nozzle/extruder fisici della stampante (1 record per single-nozzle, 2 per dual H2D/X2D).
  /// Sostituisce `nozzleDiameter`/`nozzleType` su dual-nozzle (i campi legacy restano scrivibili per back-compat).
  nozzles PrinterNozzle[] @relation("PrinterNozzles")

  /// Unità AMS collegate alla stampante. Su X2D possono essere fino a 12 (4× AMS 2 Pro + 8× AMS HT).
  /// Sostituisce `amsModel` (singolo) su multi-AMS.
  amsUnits PrinterAmsUnit[] @relation("PrinterAmsUnits")

  /// Spool esterne (`vt_tray`) per nozzle. Su single-nozzle è 1 (extruderId=0); su dual-nozzle fino a 2.
  /// Sostituisce `currentSpoolId`/`externalReported*` su dual-nozzle.
  externalSpools PrinterExternalSpool[] @relation("PrinterExternalSpools")

  /// Consumi energia aggregati giornalieri (per dashboard, include standby).
  energyDailySlices PrinterEnergyDailySlice[]

  /// Eventi di cambio stato per calcolo uptime/utilization
  stateEvents    PrinterStateEvent[]
  /// Eventi di downtime per KPI
  downtimeEvents PrinterDowntimeEvent[]

  /// Task di accodamento persistenti (flusso "send to print")
  queueTasks QueueTask[] @relation("PrinterQueueTasks")

  /// Task Gantt pianificati su questa stampante
  ganttTasks             GanttTask[]
  /// Interventi operatore registrati dal client.
  schedulerInterventions SchedulerInterventionLog[]
  /// Cicli di asciugatura JIT pianificati sulla stampante.
  assignmentDryingPlans  AssignmentDryingPlan[]     @relation("DryingPlanPrinter")
  /// Cicli di asciugatura bobina (manuali o avviati con le stampe).
  spoolDryingSessions    SpoolDryingSession[]       @relation("PrinterSpoolDryingSessions")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([operationalStatus])
  @@index([manualOverrideStatus])
  @@index([hasCompletedPrintOnBed])
  @@index([locationId])
  @@schema("print-farm")
}

/// Nozzle/extruder fisico di una stampante.
/// 1 record per single-nozzle, 2 record per dual H2D/X2D (extruderId = 0 right, 1 left).
/// Sostituisce `Printer.nozzleDiameter`/`Printer.nozzleType` su dual-nozzle (legacy resta scrivibile per 1-2 release).
model PrinterNozzle {
  id        String  @id @default(uuid()) @db.Uuid
  printerId String  @db.Uuid
  printer   Printer @relation("PrinterNozzles", fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// 0 = right/main, 1 = left/auxiliary (Bambu convention).
  extruderId Int

  /// Diametro nozzle in mm (es. 0.4, 0.6).
  diameter   Decimal @default(0.4) @db.Decimal(4, 2)
  /// Tipo nozzle (es. "Hardened Steel", "Stainless Steel").
  nozzleType String  @default("Hardened Steel")

  /// Usura % (0..100), best-effort dal firmware.
  wear         Int?
  /// Serial number nozzle (se disponibile dal firmware).
  serialNumber String?
  /// Temperatura massima °C dichiarata dal nozzle (es. 300).
  maxTempC     Int?

  /// Snapshot ultimo colore/tipo filamento "reported" dal nozzle (non spool tracking).
  lastReportedFilamentColor String?
  lastReportedFilamentType  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([printerId, extruderId])
  @@index([printerId])
  @@schema("print-farm")
}

/// Unità AMS collegata a una stampante (Bambu).
/// Su X1/P1/A1: 1 record (amsId=0). Su H2D: fino a 2. Su X2D: fino a 12 (4× AMS 2 Pro + 8× AMS HT).
/// Sostituisce `Printer.amsModel` (singleton) su multi-AMS.
model PrinterAmsUnit {
  id        String  @id @default(uuid()) @db.Uuid
  printerId String  @db.Uuid
  printer   Printer @relation("PrinterAmsUnits", fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// id MQTT (0..n). Su X2D può salire molto (fino a 12).
  amsId           Int
  amsModel        AmsModel
  serialNumber    String?
  firmwareVersion String?

  /// Extruder a cui l'AMS è agganciata (0 = right, 1 = left).
  /// null = routing dinamico via FTS (Filament Track Switch).
  extruderId Int?

  /// Telemetria: snapshot dell'ultimo MQTT.
  humidity     Int?
  tempC        Decimal? @db.Decimal(4, 1)
  /// 0=Off, 1=Checking, 2=Drying, 3=Cooling, 4=Stopping, 5=Error.
  dryStatus    Int?
  /// 0=Off, 1=Heating, 2=Dehumidify.
  drySubStatus Int?
  /// Minuti rimanenti del ciclo di drying.
  dryTimeMin   Int?

  /// Slot AMS appartenenti a questa unità (relazione 1:N opzionale verso `PrinterAmsSlot.amsUnitId`).
  slots                 PrinterAmsSlot[]       @relation("AmsUnitSlots")
  /// Cicli JIT che occupano in esclusiva questa unità durante l'asciugatura.
  assignmentDryingPlans AssignmentDryingPlan[] @relation("DryingPlanAmsUnit")
  /// Cicli di asciugatura bobina che occupano in esclusiva questa unità.
  spoolDryingSessions   SpoolDryingSession[]   @relation("AmsUnitSpoolDryingSessions")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([printerId, amsId])
  @@index([printerId])
  @@schema("print-farm")
}

/// Spool esterna (Bambu `vt_tray`) montata su un nozzle specifico.
/// Su single-nozzle: 1 record (extruderId=0). Su dual-nozzle: fino a 2 (Right su extruderId=0, Left su extruderId=1).
/// Sostituisce `Printer.currentSpoolId` + `Printer.externalReported*` su dual-nozzle.
model PrinterExternalSpool {
  id        String  @id @default(uuid()) @db.Uuid
  printerId String  @db.Uuid
  printer   Printer @relation("PrinterExternalSpools", fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// 0 = right/main, 1 = left/auxiliary.
  extruderId Int

  /// Spool tracciata associata (può essere null = solo "reported" dal firmware).
  spoolId String?        @unique @db.Uuid
  spool   FilamentSpool? @relation("ExternalSpool", fields: [spoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Snapshot "reported" dal firmware (non spool tracking) — mirror dei campi attuali su Printer.
  reportedMaterialType String?
  reportedColor        String?
  reportedTrayInfoIdx  String?
  reportedLastSeenAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([printerId, extruderId])
  @@index([printerId])
  @@schema("print-farm")
}

model PrinterModel {
  id          Int    @id @default(autoincrement())
  name        String @unique
  deviceModel String

  /// Numero di nozzle/extruder che il modello supporta a livello hardware.
  /// 1 = single (X1/P1/A1), 2 = dual (H2D/X2D). Source-of-truth per la UI.
  /// `Printer.nozzleCount` resta come mirror per back-compat con i consumer esistenti.
  nozzleCount Int @default(1)

  /// Se true, i nozzle del modello sono equivalenti (es. tutti direct drive su H2D):
  /// l'assegnazione filamento->extruder del file può essere permutata fra i nozzle.
  /// false (X2D): mappa rigida, il filamento deve usare l'extruder esatto del file.
  extruderAssignmentSwappable Boolean @default(false)

  /// Dimensioni piano di stampa (mm)
  buildPlateWidth  Decimal? @db.Decimal(8, 2) // Larghezza piano (X) in mm
  buildPlateDepth  Decimal? @db.Decimal(8, 2) // Profondità piano (Y) in mm
  buildPlateHeight Decimal? @db.Decimal(8, 2) // Altezza massima (Z) in mm

  printers              Printer[]
  /// Profili consumo energia per questo modello (per tensione/fase/materiale).
  energyProfiles        PrinterModelEnergyProfile[]
  errorCodes            ErrorCode[]                 @relation("PrinterModelErrorCode")
  /// Macro G-code compatibili con questo modello di stampante
  printerMacros         PrinterMacro[]              @relation("PrinterModelMacroCompatibility")
  /// Profili OrcaSlicer (printer/process) associati a questo modello.
  slicerProfiles        SlicerProfile[]             @relation("PrinterModelSlicerProfiles")
  /// Job di slicing eseguiti per questo modello.
  sliceJobs             SliceJob[]                  @relation("PrinterModelSliceJobs")
  /// Fattori di calibrazione appresi per file e materiale.
  schedulerCalibrations SchedulerCalibration[]

  @@schema("print-farm")
}

// ============================================================================
// ENERGIA (profili + aggregazione giornaliera)
// ============================================================================

/// Tensione di alimentazione (usa V110/V220 per evitare problemi con enum che iniziano con numeri).
enum SupplyVoltage {
  V110
  V220

  @@schema("print-farm")
}

/// Fasi logiche usate per stimare consumo energia.
enum EnergyPhaseKey {
  /// Standby senza connessione/rete (best-effort).
  STANDBY_OFFLINE
  /// Standby con connessione WiFi/rete (best-effort).
  STANDBY_ONLINE
  /// Fase di riscaldamento (piatto in heating).
  PRINT_HEAT
  /// Fase di stampa a regime.
  PRINT_RUN

  @@schema("print-farm")
}

/// Modello di AMS collegato alla stampante (Bambu).
enum AmsModel {
  AMS
  AMS_LITE
  AMS_2_PRO
  AMS_HT

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("ams_model")
  @@schema("public")
}

/// Fasi consumo AMS.
enum AmsPhaseKey {
  STANDBY
  WORKING
  DRYING

  @@schema("print-farm")
}

/// Profilo consumo energia per un modello stampante, con optional override per categoria materiale.
/// - `powerW` è in Watt (W) per evitare ambiguità kW/W.
model PrinterModelEnergyProfile {
  id String @id @default(uuid()) @db.Uuid

  printerModelId Int
  printerModel   PrinterModel @relation(fields: [printerModelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  voltage SupplyVoltage
  phase   EnergyPhaseKey

  /// Override specifico per categoria materiale (solo per ItemType.MATERIAL). Se null, vale come default del modello/fase.
  materialCategoryId String?   @db.Uuid
  materialCategory   Category? @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  powerW Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([printerModelId, voltage, phase, materialCategoryId])
  @@index([printerModelId])
  @@index([materialCategoryId])
  @@index([voltage, phase])
  @@schema("print-farm")
}

/// Profilo consumo energia per AMS.
/// - `powerW` è in Watt (W).
model AmsEnergyProfile {
  id Int @id @default(autoincrement())

  amsModel AmsModel
  phase    AmsPhaseKey
  powerW   Decimal     @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([amsModel, phase])
  @@index([amsModel])
  @@schema("print-farm")
}

/// Slice giornaliera di energia (kWh) per stampante/fase.
/// Usata per grafici energia \"totale farm\" (include standby + stampa).
///
/// Nota upsert backend (`EnergyMonitor.incrementDailyEnergySlice`):
/// - con categoria: ON CONFLICT (day, printerId, phase, materialCategoryId)
/// - senza categoria: ON CONFLICT (day, printerId, phase) WHERE materialCategoryId IS NULL
///   (indice SQL parziale `PrinterEnergyDailySlice_day_printerId_phase_null_category_key`,
///   necessario perché Postgres tratta i NULL come distinti nell'@@unique a 4 colonne)
model PrinterEnergyDailySlice {
  id String @id @default(uuid()) @db.Uuid

  day DateTime @db.Date

  printerId String  @db.Uuid
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  phase EnergyPhaseKey

  /// Categoria materiale associata (opzionale; tipicamente valorizzata per PRINT_RUN).
  materialCategoryId String?   @db.Uuid
  materialCategory   Category? @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  kwh Decimal @db.Decimal(12, 6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([day, printerId, phase, materialCategoryId])
  @@index([day])
  @@index([printerId])
  @@index([phase])
  @@index([materialCategoryId])
  @@schema("print-farm")
}

model PrinterMacro {
  id                   Int                  @id @default(autoincrement())
  name                 String
  description          String
  /// Categoria della macro (per filtri UI e organizzazione)
  category             PrinterMacroCategory @default(GENERIC)
  gcode                Json
  printerCompatibility String[]
  printers             Printer[]            @relation("PrinterCompatibility")
  /// Modelli di stampante con cui la macro è compatibile
  printerModels        PrinterModel[]       @relation("PrinterModelMacroCompatibility")
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@schema("print-farm")
}

/// Categorie supportate per le macro G-code (organizzazione UI e flussi operativi).
enum PrinterMacroCategory {
  GENERIC
  UNLOAD_FILAMENT
  LOAD_FILAMENT
  BRIGHT_COLOR_START
  CLEANING
  CALIBRATION
  MAINTENANCE
  TEST_GENERAL

  @@schema("print-farm")
}

model ErrorCode {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  description   String?
  printerModels PrinterModel[] @relation("PrinterModelErrorCode")
  solutions     String[]
  skipthiserror Boolean        @default(false)
  severity      ErrorSeverity  @default(WARNING)
  errorType     ErrorType      @default(HMS)
  /// Categoria funzionale: determina il comportamento del backend (es. FILAMENT_RUNOUT → operationalStatus).
  category      ErrorCategory  @default(WARNING)
  action        String?
  guideUrl      String?
  qrCodeUrl     String?
  qrCodeData    String?
  logs          PrinterLogs[]
  issues        PrinterIssue[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@schema("print-farm")
}

enum ErrorSeverity {
  WARNING
  CRITICAL

  @@schema("print-farm")
}

/// Categoria funzionale dell'errore.
/// Determina come il backend/UI reagiscono all'errore (es. impostare operationalStatus).
enum ErrorCategory {
  WARNING // Avviso non bloccante, la stampa può continuare
  RECOVERABLE // Errore risolvibile senza intervento urgente
  BLOCKING // Errore bloccante, richiede intervento immediato
  FILAMENT_RUNOUT // Filamento esaurito (runtime → FILAMENT_RUNOUT status)
  IGNORE // Errore ignorato (non mostrare notifiche/badge)

  @@schema("print-farm")
}

enum ErrorType {
  HMS
  PRINTING

  @@schema("print-farm")
}

model PrinterLogs {
  id          Int    @id @default(autoincrement())
  printerId   String @db.Uuid
  errorCodeId Int

  errorCode ErrorCode @relation(fields: [errorCodeId], references: [id])
  printer   Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  occurredAt DateTime  @default(now()) @db.Timestamptz(6)
  fixedAt    DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([printerId])
  @@index([occurredAt])
  @@schema("print-farm")
}

model FarmSettings {
  id           Int          @id @default(autoincrement())
  value        Json         @map("settings")
  settingsname String
  settingstype SettingsType

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([settingsname, settingstype])
  @@map("Settings")
  @@schema("print-farm")
}

enum SettingsType {
  PRINTER
  TOTAL_AVAILABLE_POWER
  COST_PER_KWH
  WORKHOURS
  WORKDAYS
  USER
  GENERAL
  SCHEDULER_PAUSED

  @@schema("print-farm")
}

enum FarmProductionStatus {
  READY_TO_PRODUCE // Pronto per essere assegnato
  NEEDS_CONFIGURATION // Manca configurazione (file, materiali, ecc.)
  AWAITING_RESOURCES // Configurato ma mancano risorse (odette, stampanti libere)
  IN_PROGRESS // In produzione
  FULFILLED // Job completato, tutti i pezzi prodotti
  FAILED // Fallito

  @@schema("print-farm")
}

enum PrintRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("print-farm")
}

enum PrinterStatus {
  FINISH
  RUNNING
  IDLE
  OFFLINE
  PAUSE
  PREPARE
  FAILED
  SLICING
  ERROR

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("printer_status")
  @@schema("public")
}

/// Stato operativo della stampante (persistente, gestito da logica applicativa).
/// Questo stato è "superiore" rispetto al PrinterStatus che arriva dal WebSocket.
enum PrinterOperationalStatus {
  AVAILABLE // Pronta per nuovi job
  QUEUED // Ha job in coda, in attesa di partire (non ancora in stampa)
  PRINTING // In stampa attiva (distingue da QUEUED che indica solo "in coda")
  NEEDS_SETUP // Richiede setup (file/configurazione) - ex TO_LOAD
  FILAMENT_RUNOUT // Filamento finito durante stampa (richiede ricarica)
  ERROR // Errore bloccante (richiede intervento)

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("printer_operational_status")
  @@schema("public")
}

/// Override manuale impostato dall'operatore.
/// Tiene separate le decisioni umane dallo stato derivato (WSS/MQTT/queue).
enum PrinterManualOverrideStatus {
  MAINTENANCE
  DISABLED
  MANUAL_PRINTING

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("printer_manual_override_status")
  @@schema("public")
}

/// Stato di un'assegnazione stampante per un ProductionJob.
/// Flusso: SCHEDULED → QUEUED → PRINTING → TO_HARVEST → COMPLETED
/// Flusso errore: QUEUED → START_FAILED (self-heal: → QUEUED quando stampante esce da ERROR)
enum AssignmentStatus {
  SCHEDULED // Pianificato, NON parte automaticamente
  QUEUED // In coda attiva, lo scheduler lo avvia appena c'è budget kW
  PRINTING // In stampa attiva (1 solo per stampante)
  TO_HARVEST // Stampa finita, da scaricare
  COMPLETED // Scaricato, tutto fatto
  FAILED // Fallito
  CANCELLED // Annullato
  ERROR // Errore
  START_FAILED // Avvio fallito: stampante in errore, serve intervento. Self-heal quando la stampante si riprende.

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("assignment_status")
  @@schema("public")
}

/// Assegnazione di una stampante a un ProductionJob.
/// Traccia la coda, lo stato, i tempi e lo scarico dei pezzi.
model PrinterAssignment {
  id     String @id @default(uuid()) @db.Uuid
  /// Progressivo numerico leggibile (BIGINT Postgres) per uso umano/reportistica.
  /// Nota: lasciamo `id` UUID come PK per non rompere relazioni/migrazioni; questo è solo un numero sequenziale.
  number BigInt @unique @default(autoincrement()) @db.BigInt

  /// Job di produzione assegnato.
  ///
  /// Nota: lo rendiamo opzionale per supportare stampe "unplanned" (senza job/prodotto),
  /// che comunque devono creare una `PrinterAssignment` per poter gestire harvest e stati operativi.
  productionJobId String?        @db.Uuid
  productionJob   ProductionJob? @relation(fields: [productionJobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Parte (ProductPart) collegata a questa assignment.
  ///
  /// Serve a selezionare sempre il file corretto (APPROVED > DRAFT) per la parte,
  /// anche per stampe "unplanned" o quando startPayload.fileId è inattendibile.
  productPartId String?      @db.Uuid
  productPart   ProductPart? @relation("ProductPartAssignments", fields: [productPartId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Stampante assegnata
  printerId String  @db.Uuid
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Relazione 1:1 (opzionale) per tracciare quale assignment "occupa" il piatto.
  /// È una relazione separata da `printer` quindi deve essere nominata.
  hasCompletedPrintOnBedOn Printer? @relation("BedOccupiedAssignment")

  /// Posizione in coda (0 = attuale, 1+ = in attesa)
  queuePosition Int              @default(0)
  status        AssignmentStatus @default(SCHEDULED)

  // === Timing ===
  scheduledAt            DateTime?  @db.Timestamptz(6) // Quando è stato schedulato
  /// Timestamp "claim" (lock) usato SOLO dallo scheduler backend per evitare doppio start.
  /// Non rappresenta l'inizio stampa: serve solo come mutex soft recuperabile (stale) in caso di crash.
  claimedAt              DateTime?  @db.Timestamptz(6)
  startedAt              DateTime?  @db.Timestamptz(6) // Inizio stampa effettivo
  completedAt            DateTime?  @db.Timestamptz(6) // Fine stampa
  /// Snapshot immutabile del piano quando il task Gantt viene collegato.
  plannedStart           DateTime?  @db.Timestamptz(6)
  plannedEnd             DateTime?  @db.Timestamptz(6)
  plannedDurationMinutes Int?
  /// Origine F6 della decisione immediata. Il task è unique per rendere retry
  /// e doppi cron idempotenti; il piano resta separato per audit/query.
  sourceGanttPlanId      String?    @db.Uuid
  sourceGanttPlan        GanttPlan? @relation("AssignmentSourceGanttPlan", fields: [sourceGanttPlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceGanttTaskId      String?    @unique @db.Uuid
  sourceGanttTask        GanttTask? @relation("AssignmentSourceGanttTask", fields: [sourceGanttTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Operazioni di raccolta pezzi associate a questa assegnazione
  harvests PrinterHarvest[]

  /// Righe contenuto odette associate (opzionale, per scarico/unplanned).
  odetteContents OdetteContent[]

  /// Operazioni di carico filamento associate
  filamentLoads PrinterFilamentLoad[]

  /// Run effettive collegate a questa assignment (storico esecuzioni reali).
  printRuns PrintRun[]

  /// Telemetria (opzionale) correlata a questa assignment:
  /// - eventi di cambio stato (quando si riesce a determinare assignmentId)
  /// - eventi di downtime correlati
  stateEvents    PrinterStateEvent[]    @relation("AssignmentStateEvents")
  downtimeEvents PrinterDowntimeEvent[] @relation("AssignmentDowntimeEvents")

  /// Issue operative/tecniche collegate a questa assignment (opzionale).
  issues                 PrinterIssue[]
  /// Task di piani diversi che hanno rappresentato questa assignment.
  ganttTasks             GanttTask[]
  /// Interventi operatore correlati, quando l'assignment è nota.
  schedulerInterventions SchedulerInterventionLog[]
  /// Piano concreto delle bobine primarie/backup per ciascun filamento del file.
  spoolPlans             AssignmentSpoolPlan[]
  /// Cicli di asciugatura JIT richiesti prima della stampa.
  dryingPlans            AssignmentDryingPlan[]     @relation("DryingPlanAssignment")

  // === Conteggi parti ===
  partsExpected Int // Parti totali attese per questa stampa (micro-assignment)
  partsProduced Int @default(0) // Parti prodotte ok
  partsRejected Int @default(0) // Parti scartate

  /// Traccia se all'operatore è già stata mostrata la notifica "Pausa per inserimento aggiuntivo"
  /// per la prima pausa di questa assegnazione (file con `requiresAdditionalInsert = true`).
  /// Evita di ripetere il messaggio dedicato sulle pause successive della stessa stampa.
  insertPauseNoticeShown Boolean @default(false)

  // === Materiale ===
  /// Categoria materiale richiesto dal file (es. "PETG", "PLA")
  materialRequired  String?
  /// Colore richiesto (es. "RED", "BLACK")
  colorRequired     String?
  /// Se il materiale è stato cambiato per questo assignment
  materialChanged   Boolean   @default(false)
  /// Timestamp conferma cambio materiale
  materialChangedAt DateTime? @db.Timestamptz(6)

  // === Note ===
  notes String?

  /// Payload JSON per avvio stampa (usato dallo scheduler backend).
  /// Contiene tutte le informazioni per far partire la stampa anche a UI chiusa.
  /// Schema (v1): { version: 1, printerSerial, fileId?, filenameToPrint, plateNumber, useAms, amsMapping, options }
  startPayload Json?

  /// Task di accodamento persistenti (flusso "send to print")
  queueTasks QueueTask[] @relation("AssignmentQueueTasks")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  /// Nota: NON usiamo più unique su (productionJobId, printerId) perché adottiamo la strategia
  /// "1 run = 1 assignment" (micro-assignments). Quindi per lo stesso job e la stessa stampante
  /// possono esistere più assignment (in coda).
  @@index([productionJobId, printerId])
  @@index([productionJobId])
  @@index([productPartId])
  @@index([printerId])
  @@index([status])
  @@index([queuePosition])
  @@index([plannedStart])
  @@index([sourceGanttPlanId])
  /// Hot path compatible-spools / scheduler: assignment attivi per stampante.
  @@index([printerId, status])
  @@schema("print-farm")
}

enum AssignmentSpoolPlanStatus {
  PLANNED
  LOADED
  CONSUMED
  CANCELLED

  @@schema("print-farm")
}

enum AssignmentSpoolPlanProvenance {
  OPEN_SPOOL
  SEALED_INVENTORY

  @@schema("print-farm")
}

enum AssignmentSpoolPlanVerification {
  VERIFIED
  OPERATOR_REVIEW_REQUIRED

  @@schema("print-farm")
}

/// Riga source-of-truth per una bobina primaria/backup pianificata.
/// La reservation vive qui: `reservedSlotId` è unique e viene rilasciato
/// azzerandolo su cancellazione/scadenza, senza lasciare lock sullo slot.
model AssignmentSpoolPlan {
  id String @id @default(uuid()) @db.Uuid

  assignmentId String            @db.Uuid
  assignment   PrinterAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  fileFilamentIndex Int
  sequence          Int

  /// Null per una bobina ancora sigillata: in quel caso `itemId` identifica
  /// l'articolo da aprire e la riga non può essere VERIFIED/automatizzabile.
  spoolId String?        @db.Uuid
  spool   FilamentSpool? @relation("AssignmentSpoolPlans", fields: [spoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  itemId  String?        @db.Uuid
  item    Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  plannedGrams Decimal @db.Decimal(10, 2)
  amsUnit      Int?
  slot         Int?

  status       AssignmentSpoolPlanStatus       @default(PLANNED)
  provenance   AssignmentSpoolPlanProvenance
  verification AssignmentSpoolPlanVerification @default(OPERATOR_REVIEW_REQUIRED)

  /// Snapshot esplicito: true solo con spool concreta, profilo tray verificato
  /// e reservation non scaduta. Non modifica i comandi inviati al backend.
  automationEligible Boolean @default(false)

  reservedSlotId       String?                @unique @db.Uuid
  reservedSlot         PrinterAmsSlot?        @relation("SpoolPlanReservedSlot", fields: [reservedSlotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reservationExpiresAt DateTime?              @db.Timestamptz(6)
  /// Cicli di asciugatura JIT generati per questa riga primaria/backup.
  dryingPlans          AssignmentDryingPlan[] @relation("DryingPlanSpoolPlan")

  planVersion Int    @default(1)
  plannedBy   String @default("scheduler-f5-v1")
  metadata    Json?  @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([assignmentId, fileFilamentIndex, sequence])
  @@index([assignmentId])
  @@index([spoolId])
  @@index([itemId])
  @@index([reservedSlotId, reservationExpiresAt])
  @@index([status])
  @@schema("print-farm")
}

/// Stato persistente del ciclo di asciugatura JIT.
enum AssignmentDryingPlanStatus {
  PLANNED
  AWAITING_OPERATOR
  DRYING
  READY
  CONSUMED
  EXPIRED
  CANCELLED
  FAILED

  @@schema("print-farm")
}

/// Ciclo di asciugatura JIT legato a una bobina fisica e a una stampa dipendente.
/// La risorsa esclusiva è l'unità AMS; lo slot identifica la bobina realmente trattata.
model AssignmentDryingPlan {
  id String @id @default(uuid()) @db.Uuid

  assignmentId String            @db.Uuid
  assignment   PrinterAssignment @relation("DryingPlanAssignment", fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  spoolPlanId String              @db.Uuid
  spoolPlan   AssignmentSpoolPlan @relation("DryingPlanSpoolPlan", fields: [spoolPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  spoolId String        @db.Uuid
  spool   FilamentSpool @relation("DryingPlanSpool", fields: [spoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  printerId String  @db.Uuid
  printer   Printer @relation("DryingPlanPrinter", fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  amsUnitId String         @db.Uuid
  amsUnit   PrinterAmsUnit @relation("DryingPlanAmsUnit", fields: [amsUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  amsSlotId String         @db.Uuid
  amsSlot   PrinterAmsSlot @relation("DryingPlanAmsSlot", fields: [amsSlotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Trasferimento fisico post-ciclo: la bobina si asciuga in `amsSlot` (es. AMS HT
  /// cablata al nozzle destro) ma la stampa la preleva da `relocationTargetSlot`
  /// (es. AMS 2 Pro sul nozzle sinistro). Senza FTS il percorso è fisico, quindi
  /// serve un passo operatore fra fine ciclo e avvio stampa.
  relocationTargetSlotId String?         @db.Uuid
  relocationTargetSlot   PrinterAmsSlot? @relation("DryingPlanRelocationSlot", fields: [relocationTargetSlotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Minuti operatore previsti per lo spostamento (0 = nessun trasferimento).
  relocationMinutes      Int?
  /// Valorizzato quando la bobina è stata effettivamente montata nel target.
  relocationDoneAt       DateTime?       @db.Timestamptz(6)

  ganttPlanId String?    @db.Uuid
  ganttPlan   GanttPlan? @relation("DryingPlanGanttPlan", fields: [ganttPlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ganttTaskId String?    @db.Uuid
  ganttTask   GanttTask? @relation("DryingPlanGanttTask", fields: [ganttTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  fileFilamentIndex Int
  extruderId        Int?
  routingReason     String?

  policy          FilamentDryingPolicy
  status          AssignmentDryingPlanStatus @default(PLANNED)
  tempC           Int
  durationMinutes Int
  freshnessHours  Int

  plannedStart   DateTime  @db.Timestamptz(6)
  plannedEnd     DateTime  @db.Timestamptz(6)
  dueBefore      DateTime  @db.Timestamptz(6)
  freshnessUntil DateTime? @db.Timestamptz(6)

  operatorConfirmedAt DateTime? @db.Timestamptz(6)
  startedAt           DateTime? @db.Timestamptz(6)
  completedAt         DateTime? @db.Timestamptz(6)
  stoppedAt           DateTime? @db.Timestamptz(6)

  commandIdempotencyKey String? @unique
  commandVersion        Int     @default(1)
  planVersion           Int     @default(1)
  plannedBy             String  @default("scheduler-drying-v1")

  failureReason String?
  metadata      Json?   @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([assignmentId, spoolPlanId, planVersion])
  @@index([assignmentId, status])
  @@index([spoolId, status])
  @@index([printerId, status])
  @@index([amsUnitId, plannedStart, plannedEnd])
  @@index([amsSlotId, status])
  @@index([relocationTargetSlotId])
  @@index([ganttTaskId])
  @@index([status, dueBefore])
  @@index([freshnessUntil])
  @@schema("print-farm")
}

enum SoftwareType {
  BAMBU_STUDIO
  MAINSAIL

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("software_type")
  @@schema("public")
}

enum PrinterBrand {
  BAMBU_LAB
  KLIPPER
  PRUSA

  /// Tipo in public/snake_case: wal2json non genera JSON valido per enum
  /// quoted nello schema "print-farm" (Realtime list_changes).
  @@map("printer_brand")
  @@schema("public")
}

enum FileStatus {
  DRAFT // Caricato, non ancora verificato
  TESTING // In fase di stampa di prova
  APPROVED // Validato per produzione massiva
  ARCHIVED // Versione vecchia, non usare
  REJECTED // Test falliti, da buttare

  @@schema("print-farm")
}

/// Operazione di raccolta pezzi stampati dalla stampante all'odette (harvesting).
/// Traccia chi ha effettuato la raccolta, quando, e la qualità dei pezzi.
model PrinterHarvest {
  id String @id @default(uuid()) @db.Uuid

  /// Assegnazione da cui provengono i pezzi
  assignmentId String            @db.Uuid
  assignment   PrinterAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Stampante da cui è stata effettuata la raccolta
  printerId String  @db.Uuid
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// PrintRun associata a questa raccolta (opzionale).
  /// Utile per tracciare direttamente quale run ha prodotto i pezzi,
  /// specialmente per stampe unplanned/manuali dove l'assignment è meno significativa.
  printRunId String?   @db.Uuid
  printRun   PrintRun? @relation(fields: [printRunId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Odette di destinazione (opzionale).
  /// Serve per permettere lo scarico anche quando non c'è un contenitore disponibile.
  odetteId String? @db.Uuid
  odette   Odette? @relation(fields: [odetteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Operatore che ha effettuato la raccolta
  harvestedByUserId Int
  harvestedByUser   User @relation("PrinterHarvests", fields: [harvestedByUserId], references: [id], onDelete: Restrict)

  /// Timestamp raccolta
  harvestedAt DateTime @default(now()) @db.Timestamptz(6)

  // === Conteggi pezzi ===
  /// Pezzi raccolti correttamente
  partsAccepted Int @default(0)
  /// Pezzi scartati (difetti, errori)
  partsRejected Int @default(0)
  /// Pezzi totali (accepted + rejected)
  partsTotal    Int @default(0)

  /// Stato dell'assignment nel momento dello scarico (es. TO_HARVEST, FAILED).
  /// Serve per annullare uno scarico ripristinando lo stato originale: senza questo dato
  /// l'assignment tornava sempre in TO_HARVEST, cambiando il comportamento del ri-scarico.
  assignmentStatusAtHarvest String?

  // === Qualità ===
  /// Scarico "saltato": il piatto è stato liberato senza raccogliere i pezzi.
  /// I pezzi vengono comunque contati in `partsRejected` (fisicamente persi), ma il flag
  /// permette di distinguerli dagli scarti di qualità in cronologia e nei report.
  wasSkipped   Boolean @default(false)
  /// Motivo scarto (se ci sono pezzi rejected)
  rejectReason String?
  /// Note dell'operatore
  notes        String?
  /// Foto/immagine dei pezzi (opzionale)
  imageUrl     String?

  /// Segnalazioni sui file aperte da questo scarico.
  feedbacks FarmFeedback[]

  /// Movimenti inventario generati da questo scarico.
  /// Serve per annullare uno scarico in modo esatto: senza questo legame l'annullamento
  /// deve indovinare i movimenti per (parte, utente, finestra temporale) e può cancellare
  /// quelli di scarichi diversi avvenuti negli stessi secondi (tipico dello scarico massivo).
  movements Movement[]

  // === Lotto ===
  /// Lotto di produzione associato
  productionLotId String?        @db.Uuid
  productionLot   ProductionLot? @relation(fields: [productionLotId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([assignmentId])
  @@index([printerId])
  @@index([printRunId])
  @@index([odetteId])
  @@index([harvestedByUserId])
  @@index([harvestedAt])
  @@index([productionLotId])
  @@schema("print-farm")
}

/// Operazione di carico filamento/materiale sulla stampante.
/// Traccia il cambio bobina e la conferma di caricamento.
model PrinterFilamentLoad {
  id String @id @default(uuid()) @db.Uuid

  /// Assegnazione per cui viene effettuato il carico (opzionale)
  assignmentId String?            @db.Uuid
  assignment   PrinterAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Stampante su cui viene caricato
  printerId String  @db.Uuid
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Operatore che ha effettuato il carico
  loadedByUserId Int
  loadedByUser   User @relation("PrinterFilamentLoads", fields: [loadedByUserId], references: [id], onDelete: Restrict)

  /// Timestamp carico
  loadedAt DateTime @default(now()) @db.Timestamptz(6)

  // === Contesto caricamento ===
  /// Motivo del carico filamento
  trigger FilamentLoadTrigger @default(MANUAL)

  /// Target: 'external' per bobina esterna, 'ams' per slot AMS
  targetKind String @default("external") @db.VarChar(10)
  /// Unità AMS (0-3). Null se targetKind = 'external'.
  amsUnit    Int?
  /// Slot AMS (0-3). Null se targetKind = 'external'.
  slot       Int?

  // === Dettagli materiale ===
  /// Bobina caricata
  spoolId          String?        @db.Uuid
  spool            FilamentSpool? @relation(fields: [spoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Materiale precedente (per tracking cambio)
  previousMaterial String?
  /// Colore precedente
  previousColor    String?
  /// Materiale nuovo
  newMaterial      String?
  /// Colore nuovo
  newColor         String?

  // === Vecchia spool ===
  /// Spool che era montata prima del cambio
  oldSpoolId     String? @db.Uuid
  /// Azione eseguita sulla vecchia spool
  oldSpoolAction String? @db.VarChar(20)

  // === Tracking inventario (per undo) ===
  /// Movement USO creato durante il prelievo (null se spool parziale/manual)
  movementId String? @db.Uuid
  /// Item prelevato da inventario (null se spool parziale)
  itemId     String? @db.Uuid

  /// Conferma che il carico è stato completato correttamente
  confirmed   Boolean   @default(false)
  confirmedAt DateTime? @db.Timestamptz(6)

  /// True se l'operazione è stata annullata (undo)
  undone   Boolean   @default(false)
  undoneAt DateTime? @db.Timestamptz(6)

  /// Note dell'operatore
  notes String?

  /// Sessioni cronometrate che hanno prodotto questo carico
  swapSessions FilamentSwapSession[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([assignmentId])
  @@index([printerId])
  @@index([loadedByUserId])
  @@index([loadedAt])
  @@schema("print-farm")
}

enum FilamentLoadTrigger {
  MANUAL
  RUNOUT
  SWAP
  MISMATCH

  @@schema("print-farm")
}

/// Sessione cronometrata di cambio/ricarica filamento eseguita da un operatore.
/// Un record per stampante+slot per ogni passaggio nel dialog di swap: misura quanto
/// tempo serve davvero per sostituire una bobina, separando l'attesa (stampante ferma
/// in attesa dell'operatore) dal lavoro effettivo (step del dialog).
model FilamentSwapSession {
  id String @id @default(uuid()) @db.Uuid

  /// Chiave generata dal client: rende idempotente l'apertura della sessione
  /// anche dopo reload della pagina (il dialog persiste il progresso in localStorage).
  clientKey String @unique

  printerId String  @db.Uuid
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Operatore che ha eseguito il cambio
  operatorUserId Int
  operatorUser   User @relation("FilamentSwapSessions", fields: [operatorUserId], references: [id], onDelete: Restrict)

  /// Motivo dell'intervento: RUNOUT (bobina esaurita) vs SWAP (cambio pianificato)
  trigger FilamentLoadTrigger @default(SWAP)

  /// Target: 'ams' oppure 'external'
  targetKind String @default("external") @db.VarChar(10)
  amsUnit    Int?
  slot       Int?
  extruderId Int?

  /// Bobina rimossa e bobina montata (best-effort: possono mancare su inventario sigillato)
  fromSpoolId String? @db.Uuid
  toSpoolId   String? @db.Uuid

  /// Carico inventario generato dallo step "monta"
  filamentLoadId String?              @db.Uuid
  filamentLoad   PrinterFilamentLoad? @relation(fields: [filamentLoadId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Quando la stampante ha richiesto l'intervento (runout/flag swap). Best-effort.
  detectedAt DateTime? @db.Timestamptz(6)
  /// Apertura del dialog sulla riga: inizio presa in carico dell'operatore
  startedAt  DateTime  @default(now()) @db.Timestamptz(6)
  /// Ultimo step registrato: serve per chiudere le sessioni abbandonate
  lastStepAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Step finale completato con successo
  finishedAt DateTime? @db.Timestamptz(6)

  /// Attesa prima dell'intervento (detectedAt → startedAt)
  waitSeconds    Int?
  /// Durata totale a orologio (startedAt → finishedAt), pause incluse
  elapsedSeconds Int?
  /// Lavoro effettivo: somma degli step, ognuno limitato per non contare le pause lunghe
  workSeconds    Int?
  /// Durata in secondi per singolo step: { unload, unmount, mount, load, done }
  stepSeconds    Json? @db.JsonB

  /// Step falliti/ritentati durante la sessione
  errorCount Int     @default(0)
  /// Sessione chiusa senza raggiungere lo step finale
  abandoned  Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([printerId, startedAt(sort: Desc)])
  @@index([operatorUserId, startedAt(sort: Desc)])
  @@index([trigger, startedAt(sort: Desc)])
  @@index([finishedAt(sort: Desc)])
  @@schema("print-farm")
}

/// Relazione M2M tra Printer e Category (solo per materiali).
/// Serve per gestire le "preferenze materiale" della stampante in modo type-safe.
/// Sostituisce il campo `Printer.preferredTags` (array di stringhe).
model PrinterPreferredMaterialCategory {
  printerId  String @db.Uuid
  categoryId String @db.Uuid

  printer  Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@id([printerId, categoryId])
  @@index([printerId])
  @@index([categoryId])
  @@schema("print-farm")
}

// ============================================================================
// GANTT SCHEDULER (Reactive Gantt – pianificazione a orizzonte temporale)
// ============================================================================

/// Stato del piano Gantt generato dal solver.
enum GanttPlanStatus {
  ACTIVE
  SUPERSEDED
  FAILED

  @@schema("print-farm")
}

/// Stato di un singolo task nel piano Gantt.
enum GanttTaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  DELAYED

  @@schema("print-farm")
}

/// Rappresenta un'esecuzione del Gantt Scheduler (snapshot pianificazione).
/// Ogni volta che il cron o l'operatore ricalcola il piano, viene creato un nuovo GanttPlan
/// e il precedente viene marcato come SUPERSEDED.
model GanttPlan {
  id String @id @default(uuid()) @db.Uuid

  status       GanttPlanStatus @default(ACTIVE)
  /// Orizzonte di pianificazione: inizio e fine dell'intervallo calcolato.
  horizonStart DateTime        @db.Timestamptz(6)
  horizonEnd   DateTime        @db.Timestamptz(6)

  /// Statistiche solver
  solverStatus      String?
  solverObjective   Decimal? @db.Decimal(16, 2)
  solverDurationMs  Int?
  jobsEvaluated     Int      @default(0)
  printersEvaluated Int      @default(0)
  /// Diagnostica F3: copertura, churn, carryover, potatura e decisione di replan.
  diagnostics       Json?    @db.JsonB
  /// Bucket capacitivi giornalieri oltre l'orizzonte tattico dettagliato.
  capacityPlan      Json?    @db.JsonB

  /// Task (blocchi temporali) del piano
  tasks             GanttTask[]
  etaSnapshots      SchedulerOrderEtaSnapshot[]
  sourceAssignments PrinterAssignment[]         @relation("AssignmentSourceGanttPlan")
  dryingPlans       AssignmentDryingPlan[]      @relation("DryingPlanGanttPlan")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@schema("print-farm")
}

/// Singolo blocco temporale nel diagramma Gantt: un job pianificato su una stampante
/// con inizio/fine stimati. Può anche rappresentare un "setup" (cambio filamento).
model GanttTask {
  id String @id @default(uuid()) @db.Uuid

  ganttPlanId String    @db.Uuid
  ganttPlan   GanttPlan @relation(fields: [ganttPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Stampante assegnata
  printerId String  @db.Uuid
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Job di produzione (null se il task è un setup/filament change)
  productionJobId String?        @db.Uuid
  productionJob   ProductionJob? @relation(fields: [productionJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Assignment reale collegata a questa run pianificata.
  /// Non è unique globalmente: la stessa assignment può apparire in snapshot
  /// Gantt successivi. Il vincolo composto evita duplicati nello stesso piano.
  assignmentId     String?                @db.Uuid
  assignment       PrinterAssignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Assignment creata direttamente da questo task (relazione audit F6).
  sourceAssignment PrinterAssignment?     @relation("AssignmentSourceGanttTask")
  /// Cicli JIT dipendenti da questo blocco di stampa.
  dryingPlans      AssignmentDryingPlan[] @relation("DryingPlanGanttTask")

  /// Ordine di produzione (denormalizzato per query rapide nella UI)
  productOrderId String? @db.Uuid

  /// Tempi pianificati
  plannedStart DateTime @db.Timestamptz(6)
  plannedEnd   DateTime @db.Timestamptz(6)

  /// Durata in minuti (ridondante ma comodo per query/visualizzazione)
  durationMinutes Int

  /// Posizione nella sequenza per questa stampante (0 = primo, 1 = secondo, ...)
  sequenceIndex Int @default(0)

  /// Tipo di blocco: false = stampa effettiva, true = setup/cambio filamento
  isSetup Boolean @default(false)

  /// Dettagli materiale (per visualizzazione e validazione)
  materialCategory String?
  colorHex         String?

  /// Parti attese da questa stampa
  partsExpected Int @default(0)

  /// Stato runtime del task
  taskStatus GanttTaskStatus @default(PLANNED)

  /// Note/label per la UI
  label String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([ganttPlanId, assignmentId])
  @@index([ganttPlanId])
  @@index([printerId])
  @@index([productionJobId])
  @@index([assignmentId])
  @@index([productOrderId])
  @@index([taskStatus])
  @@index([plannedStart])
  @@schema("print-farm")
}

/// Fattori appresi da run reali con identità file/modello/materiale affidabile.
/// `scopeKey` evita la semantica ambigua degli unique composti con file nullable.
model SchedulerCalibration {
  id       String @id @default(uuid()) @db.Uuid
  scopeKey String @unique

  printerModelId Int
  printerModel   PrinterModel @relation(fields: [printerModelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  materialCategory String

  fileId String             @db.Uuid
  file   ProjectThreeMFFile @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  durationFactor   Decimal @default(1) @db.Decimal(10, 6)
  /// Varianza campionaria del rapporto durata reale/stimata.
  durationVariance Decimal @default(0) @db.Decimal(12, 8)
  filamentFactor   Decimal @default(1) @db.Decimal(10, 6)
  failureRate      Decimal @default(0) @db.Decimal(10, 6)

  sampleCount         Int @default(0)
  durationSampleCount Int @default(0)
  filamentSampleCount Int @default(0)
  failureSampleCount  Int @default(0)

  windowStart DateTime? @db.Timestamptz(6)
  windowEnd   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([printerModelId, materialCategory])
  @@index([fileId])
  @@schema("print-farm")
}

/// Snapshot prospettico dell'ETA ordine prodotto da un piano Gantt valido.
/// Consente di misurare T-24h/T-72h solo da quando gli snapshot esistono.
model SchedulerOrderEtaSnapshot {
  id String @id @default(uuid()) @db.Uuid

  ganttPlanId String    @db.Uuid
  ganttPlan   GanttPlan @relation(fields: [ganttPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productOrderId String       @db.Uuid
  productOrder   ProductOrder @relation(fields: [productOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  forecastAt DateTime @default(now()) @db.Timestamptz(6)
  etaP50     DateTime @db.Timestamptz(6)
  etaP80     DateTime @db.Timestamptz(6)
  confidence Float
  source     String
  coverage   Float
  breakdown  Json     @db.JsonB

  @@unique([ganttPlanId, productOrderId])
  @@index([productOrderId, forecastAt])
  @@index([forecastAt])
  @@schema("print-farm")
}

enum SchedulerInterventionType {
  FILAMENT_SWAP
  FILAMENT_DRYING
  SPOOL_MOVE
  PLATE_CHANGE
  MANUAL_RETRY
  MANUAL_OVERRIDE

  @@schema("print-farm")
}

enum SchedulerInterventionSource {
  PLANNED
  UNPLANNED
  UNKNOWN

  @@schema("print-farm")
}

/// Evento operatore affidabile prodotto da un flusso client persistito.
model SchedulerInterventionLog {
  id       String  @id @default(uuid()) @db.Uuid
  eventKey String? @unique

  type   SchedulerInterventionType
  source SchedulerInterventionSource @default(UNKNOWN)

  printerId String?  @db.Uuid
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  assignmentId String?            @db.Uuid
  assignment   PrinterAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([type, createdAt])
  @@index([printerId, createdAt])
  @@index([assignmentId])
  @@schema("print-farm")
}

// ============================================================================
// SCHEDULER CONFIG & SCENARIO ANALYSIS
// ============================================================================

/// Profilo di configurazione dello scheduler: un set versionato di pesi, penalità e flag.
/// Un solo profilo alla volta può essere ACTIVE; gli altri restano DRAFT o ARCHIVED.
model SchedulerConfigProfile {
  id   String @id @default(uuid()) @db.Uuid
  name String

  status SchedulerConfigProfileStatus @default(DRAFT)
  notes  String?

  values       SchedulerConfigValue[]
  scenarioRuns SchedulerScenarioRun[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@schema("print-farm")
}

enum SchedulerConfigProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("print-farm")
}

/// Singolo parametro chiave/valore di un profilo di configurazione scheduler.
/// Supporta valori numerici, booleani e di testo. La categoria raggruppa i parametri nella UI.
model SchedulerConfigValue {
  id        String                 @id @default(uuid()) @db.Uuid
  profileId String                 @db.Uuid
  profile   SchedulerConfigProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  key         String
  valueNum    Decimal? @db.Decimal(16, 4)
  valueBool   Boolean?
  valueText   String?
  category    String   @default("general")
  description String?
  editable    Boolean  @default(true)

  @@unique([profileId, key])
  @@index([profileId])
  @@schema("print-farm")
}

/// Esecuzione (reale o simulata) dello scheduler con uno specifico profilo.
/// Salva snapshot della configurazione, outcome del solver e metadata input.
model SchedulerScenarioRun {
  id        String                  @id @default(uuid()) @db.Uuid
  profileId String?                 @db.Uuid
  profile   SchedulerConfigProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  runType        SchedulerRunType @default(REAL)
  label          String?
  configSnapshot Json?

  solverStatus      String?
  solverObjective   Decimal? @db.Decimal(16, 2)
  solverDurationMs  Int?
  jobsEvaluated     Int      @default(0)
  printersEvaluated Int      @default(0)

  assignmentsCreated Int @default(0)
  assignmentsKept    Int @default(0)

  inputMetadata Json?

  candidates SchedulerScenarioCandidate[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([runType])
  @@index([createdAt])
  @@schema("print-farm")
}

enum SchedulerRunType {
  REAL
  SIMULATION

  @@schema("print-farm")
}

/// Matrice candidato job-printer di uno scenario: contiene score, penalty, fattibilità e breakdown.
model SchedulerScenarioCandidate {
  id    String               @id @default(uuid()) @db.Uuid
  runId String               @db.Uuid
  run   SchedulerScenarioRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  jobId       String  @db.Uuid
  jobNumber   String?
  printerId   String  @db.Uuid
  printerName String?

  feasible       Boolean @default(true)
  hardFailReason String?

  score   Int @default(0)
  penalty Int @default(0)
  net     Int @default(0)

  selected Boolean @default(false)

  breakdown Json?

  @@index([runId])
  @@index([runId, jobId])
  @@index([runId, printerId])
  @@schema("print-farm")
}
