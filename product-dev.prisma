/// Sviluppo nuovi prodotti (Product Console → Sviluppo prodotti): dall'idea trovata su un sito
/// alla pubblicazione e al monitoraggio. Schema Postgres `product`, di proprietà di Product Console.
/// Le sotto-attività di ogni fase sono attività condivise (schema `tasks`, modulo ricreo-attivita):
/// qui solo il legame (ProductDevTask). Gli utenti sono public."User".id (niente FK: tabella di auth).

/// Fase del percorso di sviluppo.
enum ProductDevStage {
  /// Potenziale prodotto appena aggiunto (sito, estensione Chrome, opportunità).
  IDEA
  /// In revisione: si decide se farlo, prezzo, canali, FBA/FBM.
  REVIEW
  /// Progettazione del pezzo (3MF, foto, note).
  DESIGN
  /// Preparazione: info utili, GS1/EAN, foto, infografiche.
  CONTENT
  /// Pubblicazione dalle bozze Crossplatform e produzione per l'inventario.
  PUBLISHING
  /// Monitoraggio vendite e recensioni.
  MONITORING
  /// Miglioramento: infografiche, design, listing.
  IMPROVEMENT

  @@schema("product")
}

/// Stato complessivo, indipendente dalla fase.
enum ProductDevStatus {
  ACTIVE
  /// Da fare dopo (deciso in revisione o rimandato a mano).
  PARKED
  ARCHIVED

  @@schema("product")
}

/// Tipo di file allegato a un prodotto in sviluppo.
enum ProductDevFileKind {
  IMAGE
  /// Modello 3MF (lo stesso che va nella bozza Crossplatform).
  MODEL
  DOCUMENT

  @@schema("product")
}

/// Prodotto in sviluppo: una card della bacheca Sviluppo prodotti.
model ProductDevItem {
  id             String           @id @default(cuid())
  title          String
  notes          String           @default("")
  stage          ProductDevStage  @default(IDEA)
  status         ProductDevStatus @default(ACTIVE)
  /// MANUAL | EXTENSION | OPPORTUNITY
  source         String           @default("MANUAL")
  sourceUrl      String?
  /// Sito di provenienza (Amazon, Etsy, MakerWorld, …).
  sourceSite     String?
  sourcePrice    Decimal?         @db.Decimal(12, 2)
  sourceCurrency String?
  /// Opportunità concorrenti da cui nasce (CompetitorProductMatch.id o CompetitorProduct.id).
  opportunityId  String?
  /// ProductDevFile scelto come copertina.
  coverFileId    String?

  /// Revisione: ACCEPTED | LATER | ARCHIVED, chi e quando.
  reviewDecision String?
  reviewNote     String?
  decidedById    Int?
  decidedAt      DateTime?        @db.Timestamptz(6)
  /// Prezzo di vendita deciso (EUR).
  targetPrice    Decimal?         @db.Decimal(12, 2)
  /// Canali scelti in revisione.
  channels       StoreChannel[]
  /// FBA | FBM | BOTH
  fulfillment    String?

  /// Progettazione.
  designerId     Int?
  designDueDate  DateTime?        @db.Date
  designNotes    String           @default("")
  designDoneAt   DateTime?        @db.Timestamptz(6)
  designDoneById Int?

  /// Preparazione: EAN da GS1, SKU, link utili e inserzioni concorrenti
  /// ([{ id, kind: INFO | COMPETITOR, url, label }]).
  ean            String?
  sku            String?
  links          Json             @default("[]")

  /// Pubblicazione: bozza Crossplatform collegata e produzione per l'inventario.
  draftId          String?
  publishedAt      DateTime?      @db.Timestamptz(6)
  productionQty    Int?
  productionDoneAt DateTime?      @db.Timestamptz(6)
  /// Processo finito (passato al monitoraggio).
  completedAt      DateTime?      @db.Timestamptz(6)

  stageChangedAt DateTime @default(now()) @db.Timestamptz(6)
  /// Posizione nella colonna della bacheca (crescente).
  sortOrder      Float    @default(0)
  createdById    Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  files  ProductDevFile[]
  tasks  ProductDevTask[]
  events ProductDevEvent[]

  @@index([status, stage, sortOrder], map: "ProductDevItem_board")
  @@index([draftId], map: "ProductDevItem_draft")
  @@index([opportunityId], map: "ProductDevItem_opportunity")
  @@schema("product")
}

/// Foto, 3MF e documenti di un prodotto in sviluppo (bucket inventory, cartella product-dev/).
model ProductDevFile {
  id           String             @id @default(cuid())
  itemId       String
  kind         ProductDevFileKind
  /// Fase in cui è stato caricato (reference in IDEA, 3MF in DESIGN, foto in CONTENT, …).
  stage        ProductDevStage
  /// Object path nel bucket; null = immagine esterna non scaricata.
  objectPath   String?
  externalUrl  String?
  fileName     String
  contentType  String?
  size         Int?
  caption      String?
  uploadedById Int?
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)

  item ProductDevItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt], map: "ProductDevFile_item")
  @@schema("product")
}

/// Attività condivisa (tasks.task) di una fase del prodotto: una per tipo.
model ProductDevTask {
  id        String          @id @default(cuid())
  itemId    String
  /// REVIEW | DESIGN | CONTENT | PUBLISHING | PUBLICATION_CHECK | MONITORING | IMPROVEMENT
  kind      String
  stage     ProductDevStage
  /// tasks.task.id dell'attività principale (le sotto-attività sono le sue sottotask).
  taskId    String          @db.Uuid
  createdAt DateTime        @default(now()) @db.Timestamptz(6)

  item ProductDevItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, kind], map: "ProductDevTask_item_kind")
  @@index([taskId], map: "ProductDevTask_task")
  @@schema("product")
}

/// Storico del prodotto in sviluppo (cambi di fase, decisioni, file, pubblicazione).
model ProductDevEvent {
  id        String           @id @default(cuid())
  itemId    String
  /// CREATED | STAGE | DECISION | STATUS | FILE | COVER | DESIGN_DONE | DRAFT | PUBLISHED | PRODUCTION | UPDATE
  type      String
  stage     ProductDevStage?
  message   String
  data      Json?
  userId    Int?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  item ProductDevItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt], map: "ProductDevEvent_item")
  @@schema("product")
}

/// Chi fa cosa nello sviluppo prodotti (singleton): revisori, progettista, ricerca info, fotografo, …
model ProductDevSettings {
  id        String   @id @default("default")
  /// { reviewers: number[], designer, researcher, photographer, publisher, producer, monitor: number | null }
  roles     Json     @default("{}")
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@schema("product")
}

/// Token personali per client esterni (estensione Chrome "Product Saver"): Authorization Bearer.
model ConsoleApiToken {
  id         String    @id @default(cuid())
  /// public."User".id del proprietario: quello che il token fa, lo fa a suo nome.
  userId     Int
  name       String
  /// SHA-256 esadecimale del token (il token in chiaro si vede solo alla creazione).
  tokenHash  String    @unique
  /// Inizio del token, per riconoscerlo nella lista (pc_ab12…).
  prefix     String
  lastUsedAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId], map: "ConsoleApiToken_user")
  @@schema("product")
}
