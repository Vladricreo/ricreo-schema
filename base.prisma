generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  // relationJoins: un solo SQL (LATERAL JOIN + json_agg) per gli include,
  // invece di N queryRaw in sequenza (più lento in transazione PrismaPg).
  previewFeatures = ["views", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "inventory", "print-farm", "inventory_views", "print_farm_views", "product"]
}

