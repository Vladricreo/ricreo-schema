/// Snapshot giornaliero inventario FBA dal ledger Amazon (Summary View).
/// Una riga Amazon = data + FNSKU + disposition + paese (location COUNTRY).
model StoreFbaInventoryDaily {
  id       String       @id @default(cuid())
  channel  StoreChannel
  /// Marketplace usato per createReport (storeKey della selling region).
  storeKey String
  date     DateTime     @db.Date
  fnsku    String
  asin     String
  msku     String
  title    String       @default("")
  /// Es. SELLABLE / UNSSELLABLE. Lo stock vendibile è solo SELLABLE.
  disposition String
  /// Paese ISO o FC, a seconda di aggregateByLocation.
  location String

  startingWarehouseBalance     Int @default(0)
  inTransitBetweenWarehouses   Int @default(0)
  receipts                     Int @default(0)
  customerShipments            Int @default(0)
  customerReturns              Int @default(0)
  vendorReturns                Int @default(0)
  warehouseTransferInOut       Int @default(0)
  found                        Int @default(0)
  lost                         Int @default(0)
  damaged                      Int @default(0)
  disposed                     Int @default(0)
  otherEvents                  Int @default(0)
  endingWarehouseBalance       Int @default(0)
  unknownEvents                Int @default(0)

  /// Colonne Amazon non mappate: non perdiamo dati se il TSV cambia.
  extra Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, date, fnsku, disposition, location], map: "StoreFbaInventoryDaily_grain")
  @@index([asin, date])
  @@index([msku, date])
  @@index([endingWarehouseBalance])
  @@index([channel, storeKey, date])
  @@schema("product")
}

