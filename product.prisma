/// Tassi di cambio verso EUR da Frankfurter (BCE e altre banche centrali).
/// `rate` = unità di `currency` per 1 EUR (es. 1 EUR = 0,86 GBP).
model ExchangeRate {
  id String @id @default(cuid())
  /// Valuta quotata (ISO 4217), es. GBP, PLN, SEK.
  currency String
  /// Base sempre EUR.
  base String @default("EUR")
  /// Quante unità di `currency` equivalgono a 1 EUR.
  rate Decimal @db.Decimal(18, 8)
  /// Data della rilevazione pubblicata da Frankfurter.
  rateDate DateTime @db.Date
  /// Origine del dato (es. frankfurter).
  source String @default("frankfurter")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([currency], map: "ExchangeRate_currency")
  @@index([rateDate], map: "ExchangeRate_rateDate")
  @@schema("product")
}

