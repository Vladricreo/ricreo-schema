/// Mapping tra identificativi esterni ERP e goodsId Temu dopo create V3.
/// Schema Postgres `product`: di proprietà di Product Console.
model TemuGoodsMapping {
  id              String   @id @default(cuid())
  /// Identificativo esterno inviato a Temu (`externalGoodsId`).
  externalGoodsId String
  /// Identificativo generato da Temu (`goodsId`).
  goodsId         String
  /// SKU esterni associati alla create (convenience).
  externalSkuIds  String[] @default([])
  /// skuId Temu del primo SKU, usato per `bg.local.goods.priceorder.change.sku.price`.
  temuSkuId       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@unique([externalGoodsId])
  @@index([goodsId])
  @@schema("product")
}

/// Credenziali OAuth Etsy per un singolo shop (Seller App).
/// Access token ~1h; refresh token ~90 giorni (può ruotare al refresh).
/// `accessToken` e `refreshToken` sono AES-256-GCM (SETTINGS_ENCRYPTION_KEY).
model EtsyOAuthCredential {
  id           String   @id @default(cuid())
  /// Shop Etsy autorizzato (`ETSY_SHOP_ID`).
  shopId       String
  /// Access token cifrato (payload Settings v1).
  accessToken  String
  /// Refresh token cifrato (payload Settings v1).
  refreshToken String
  /// Scadenza access token (UTC).
  expiresAt    DateTime @db.Timestamptz(6)
  /// Scope concessi (spazio-separati), es. `listings_r listings_w shops_r transactions_r`.
  scopes       String   @default("")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([shopId])
  @@schema("product")
}

/// Credenziali OAuth eBay (user token) per un account seller.
/// Access token ~2h; refresh token ~18 mesi.
/// `accessToken` e `refreshToken` sono AES-256-GCM (SETTINGS_ENCRYPTION_KEY).
model EbayOAuthCredential {
  id           String   @id @default(cuid())
  /// Chiave logica dell'account (es. `primary` o username eBay).
  accountKey   String
  /// Access token cifrato (payload Settings v1).
  accessToken  String
  /// Refresh token cifrato (payload Settings v1).
  refreshToken String
  /// Scadenza access token (UTC).
  expiresAt    DateTime @db.Timestamptz(6)
  /// Scope concessi (spazio-separati).
  scopes       String   @default("")
  ebayUserId   String?
  ebayUsername String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([accountKey])
  @@schema("product")
}

/// Notifica eBay MARKETPLACE_ACCOUNT_DELETION ricevuta dalla Edge Function pubblica.
/// Identificativi utente e payload sono cifrati con SETTINGS_ENCRYPTION_KEY.
model EbayAccountDeletion {
  id              String    @id @default(uuid())
  /// Id notifica eBay (idempotenza: la stessa notifica può arrivare più volte).
  notificationId  String
  topic           String    @default("MARKETPLACE_ACCOUNT_DELETION")
  eventDate       DateTime? @db.Timestamptz(6)
  /// Username eBay cifrato (payload Settings v1).
  usernameEnc     String?
  /// userId eBay cifrato (payload Settings v1).
  userIdEnc       String?
  /// eiasToken cifrato (payload Settings v1).
  eiasTokenEnc    String?
  /// Payload JSON completo cifrato (o redacted se manca la chiave).
  payloadEnc      String
  signatureValid  Boolean   @default(false)
  /// Valorizzato quando l'app privata ha elaborato la cancellazione.
  processedAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([notificationId])
  @@index([processedAt])
  @@index([createdAt])
  @@schema("product")
}

/// Canale store su cui vive uno SKU (stesso SKU su Amazon, Etsy, eBay, Temu).
enum StoreChannel {
  AMAZON
  ETSY
  EBAY
  TEMU

  @@schema("product")
}

/// Stato di un job Reports SP-API (createReport è asincrono).
enum StoreReportStatus {
  REQUESTED
  DONE
  FAILED
  CANCELLED

  @@schema("product")
}

/// Vendite giornaliere per SKU e store. Chiave comune futura: SKU + channel + storeKey.
model StoreSalesDaily {
  id      String       @id @default(cuid())
  channel StoreChannel
  /// Amazon: marketplaceId; in futuro shop Etsy / marketplace eBay / region Temu.
  storeKey String
  sku      String
  date     DateTime    @db.Date

  asin        String?
  productName String?

  unitsOrdered        Int     @default(0)
  unitsRefunded       Int     @default(0)
  unitsShipped        Int     @default(0)
  orderedProductSales Decimal @default(0) @db.Decimal(12, 2)
  currency            String  @default("EUR")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, sku, date])
  @@index([sku, date])
  @@index([channel, date])
  @@index([channel, sku, date])
  @@schema("product")
}

/// Traffico giornaliero Sales and Traffic (sessioni, page view, Buy Box).
/// `sku = "*"` = totali catalogo per store×giorno (salesAndTrafficByDate).
model StoreTrafficDaily {
  id      String       @id @default(cuid())
  channel StoreChannel
  storeKey String
  sku      String
  date     DateTime    @db.Date

  asin       String?
  parentAsin String?

  sessions               Int     @default(0)
  pageViews              Int     @default(0)
  buyBoxPercentage       Decimal? @db.Decimal(7, 4)
  unitSessionPercentage  Decimal? @db.Decimal(7, 4)
  unitsOrdered           Int     @default(0)
  orderedProductSales    Decimal @default(0) @db.Decimal(12, 2)
  totalOrderItems        Int     @default(0)
  averageSellingPrice    Decimal? @db.Decimal(12, 2)
  currency               String  @default("EUR")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, sku, date], map: "StoreTrafficDaily_day_key")
  @@index([sku, date])
  @@index([channel, date])
  @@index([channel, sku, date])
  @@index([asin, date])
  @@schema("product")
}

/// Funnel ricerca Brand Analytics a livello ASIN (Search Catalog Performance).
model StoreSearchCatalogPeriod {
  id         String       @id @default(cuid())
  channel    StoreChannel
  storeKey   String
  asin       String
  periodType String
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date

  impressionCount    Int      @default(0)
  clickCount         Int      @default(0)
  clickRate          Decimal? @db.Decimal(7, 4)
  cartAddCount       Int      @default(0)
  purchaseCount      Int      @default(0)
  conversionRate     Decimal? @db.Decimal(7, 4)
  searchTrafficSales Decimal  @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, asin, periodType, startDate], map: "StoreSearchCatalog_period_key")
  @@index([channel, storeKey, startDate])
  @@index([asin, startDate])
  @@schema("product")
}

/// Funnel ricerca Brand Analytics per query × ASIN (Search Query Performance).
model StoreSearchQueryPeriod {
  id         String       @id @default(cuid())
  channel    StoreChannel
  storeKey   String
  asin       String
  searchQuery String
  periodType String
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date

  searchQueryScore  Decimal? @db.Decimal(12, 4)
  searchQueryVolume Int      @default(0)

  totalQueryImpressionCount Int      @default(0)
  asinImpressionCount       Int      @default(0)
  asinImpressionShare       Decimal? @db.Decimal(7, 4)

  totalClickCount Int      @default(0)
  asinClickCount  Int      @default(0)
  asinClickShare  Decimal? @db.Decimal(7, 4)

  totalCartAddCount Int      @default(0)
  asinCartAddCount  Int      @default(0)
  asinCartAddShare  Decimal? @db.Decimal(7, 4)

  totalPurchaseCount Int      @default(0)
  asinPurchaseCount  Int      @default(0)
  asinPurchaseShare  Decimal? @db.Decimal(7, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, asin, searchQuery, periodType, startDate], map: "StoreSearchQuery_period_key")
  @@index([channel, storeKey, startDate])
  @@index([searchQuery])
  @@index([asin, startDate])
  @@schema("product")
}

/// Riga ordine (FBA e FBM). Serve per paese, canale di fulfillment e ricavi.
model StoreOrderLine {
  id      String       @id @default(cuid())
  channel StoreChannel
  storeKey String
  /// Chiave idempotente (es. amazonOrderId + orderItemId).
  lineKey  String

  /// ID ordine del canale (Amazon / eBay / Etsy / Temu).
  amazonOrderId String?
  orderItemId   String?
  purchaseDate  DateTime? @db.Timestamptz(6)

  /// Amazon: FBA / FBM. Null sugli altri canali.
  fulfillmentChannel String?
  salesChannel       String?
  shipCountry        String?

  sku         String
  asin        String?
  productName String?
  quantity    Int      @default(0)
  itemPrice   Decimal? @db.Decimal(12, 2)
  /// IVA riga (Amazon la calcola per paese di spedizione).
  itemTax     Decimal? @db.Decimal(12, 2)
  /// Spedizione addebitata al cliente (non il costo seller).
  shippingPrice Decimal? @db.Decimal(12, 2)
  shippingTax   Decimal? @db.Decimal(12, 2)
  itemPromotionDiscount Decimal? @db.Decimal(12, 2)
  shipPromotionDiscount Decimal? @db.Decimal(12, 2)
  itemStatus  String?
  currency    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, lineKey])
  @@index([sku, purchaseDate])
  @@index([storeKey, purchaseDate])
  @@index([fulfillmentChannel])
  @@index([channel, sku, purchaseDate])
  // Serve le finestre equal-time delle coorti di lancio (ASIN × data).
  @@index([channel, asin, purchaseDate], map: "StoreOrderLine_channel_asin_date")
  @@index([amazonOrderId])
  @@schema("product")
}

/// Alias paese libero (Etsy e altri) → ISO-2, per IVA di destinazione.
model StoreCountryAlias {
  id String @id @default(cuid())
  /// Stringa grezza normalizzata (trim + lower), unica.
  rawName String
  /// Codice ISO-3166-1 alpha-2 (GB, non UK).
  countryCode String @db.Char(2)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([rawName])
  @@index([countryCode])
  @@schema("product")
}

/// Pick&pack FBA reale da Finances API (non Fee Preview).
/// Una riga per ordine + item; l'analytics la somma sul periodo.
model StoreOrderFee {
  id      String       @id @default(cuid())
  channel StoreChannel

  amazonOrderId String
  /// Vuoto se Amazon non invia OrderItemId.
  orderItemId   String @default("")
  sku           String

  /// Pick&pack / peso FBA addebitato da Amazon (valore assoluto).
  fbaFulfillmentFee Decimal @db.Decimal(12, 4)
  /// Commissione di vendita (Commission + closing + digital services).
  referralFee       Decimal @default(0) @db.Decimal(12, 4)
  /// Digital Services Fee, già inclusa in referralFee: serve solo allo scorporo in UI.
  digitalServicesFee Decimal @default(0) @db.Decimal(12, 4)
  /// Storno spedizione FBA da Settlement/Finances (valore assoluto).
  shippingChargeback Decimal @default(0) @db.Decimal(12, 4)
  /// Commissione sul rimborso (RefundCommission).
  refundCommission   Decimal @default(0) @db.Decimal(12, 4)
  /// Altre ItemFees Amazon non classificate (valore assoluto).
  otherFee           Decimal @default(0) @db.Decimal(12, 4)
  currency          String  @default("EUR")
  postedDate        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, amazonOrderId, orderItemId, sku], map: "StoreOrderFee_item_key")
  @@index([sku], map: "StoreOrderFee_sku_idx")
  @@index([amazonOrderId], map: "StoreOrderFee_order_idx")
  @@schema("product")
}

/// Stima commissioni Amazon (Fee Preview, max 1 report/giorno).
/// Referral e fee FBA per SKU; le EFN sono per paese di destinazione.
model StoreSkuFeeEstimate {
  id      String       @id @default(cuid())
  channel StoreChannel
  storeKey String
  sku      String

  currency            String?
  referralFeePerUnit  Decimal? @db.Decimal(12, 4)
  fbaFeeDomestic      Decimal? @db.Decimal(12, 4)
  /// Chiavi ISO paese (IT, DE, GB, …) → fee FBA EFN per unità.
  fbaFeeByCountry     Json?
  estimatedFeeTotal   Decimal? @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, sku])
  @@index([sku])
  @@schema("product")
}

/// Reso post-spedizione (report FBA o FBM), distinto dagli ordini cancellati.
model StoreReturnLine {
  id             String       @id @default(cuid())
  channel        StoreChannel
  storeKey       String
  idempotencyKey String       @unique

  amazonOrderId      String?
  sku                String
  asin               String?
  productName        String?
  quantity           Int      @default(0)
  returnDate         DateTime @db.Date
  /// Codice motivo selezionabile (es. QUALITY_UNACCEPTABLE / Return Reason).
  reason             String?
  /// Testo libero descrittivo (FBA: customer-comments).
  reasonDescription  String?
  status             String?
  /// Amazon: FBA o FBM. Null sugli altri canali.
  amazonFulfillment  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([sku, returnDate])
  @@index([storeKey, returnDate])
  @@schema("product")
}

/// Snapshot giornaliero del Best Seller Rank (BSR) per ASIN, paese e categoria.
/// SP-API Catalog Items restituisce solo il rank corrente: lo storico va costruito qui.
model StoreBsrSnapshot {
  id         String       @id @default(cuid())
  channel    StoreChannel
  /// Amazon: marketplaceId (identifica il paese dello store).
  storeKey   String
  /// ISO 3166-1 alpha-2 del paese (IT, DE, FR, …), denormalizzato da storeKey.
  countryCode String
  asin       String
  sku        String?
  /// Giorno UTC dello snapshot (un punto al giorno per categoria).
  capturedAt DateTime     @db.Date
  /// Titolo categoria Amazon (es. "Home & Kitchen").
  category   String
  /// classificationId, websiteDisplayGroup o fallback sul titolo.
  categoryKey String
  /// `classification` (browse node) o `displayGroup` (reparto vetrina).
  kind       String
  rank       Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, asin, capturedAt, kind, categoryKey], map: "StoreBsrSnapshot_rank_key")
  @@index([asin, storeKey, capturedAt], map: "StoreBsrSnapshot_asin_store_date")
  @@index([asin, countryCode, capturedAt], map: "StoreBsrSnapshot_asin_country_date")
  @@schema("product")
}

/// Media stelle (o feedback eBay) e conteggio per listing.
/// `asin` è l'id listing del canale: ASIN Amazon, ItemID eBay, listing_id Etsy, goodsId Temu.
/// Amazon: una riga prodotto (`storeKey` = AMAZON), non per paese. Etsy/eBay restano per store.
model StoreReviewSummary {
  id          String       @id @default(cuid())
  channel     StoreChannel
  storeKey    String
  countryCode String
  /// Id listing del marketplace (ASIN / ItemID / listing_id / goodsId).
  asin        String
  sku         String?
  capturedAt  DateTime     @db.Date
  rating      Decimal      @db.Decimal(2, 1)
  count       Int
  /// Percentuali 5→1 stelle, se presenti sulla pagina recensioni.
  histogram   Json?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, asin, capturedAt], map: "StoreReviewSummary_day_key")
  @@index([asin, storeKey], map: "StoreReviewSummary_asin_store")
  @@schema("product")
}

/// Recensione o feedback cliente. Amazon: una riga per `externalId` (prodotto), non per paese.
model StoreCustomerReview {
  id           String       @id @default(cuid())
  channel      StoreChannel
  storeKey     String
  countryCode  String
  /// Id listing del marketplace (ASIN / ItemID / listing_id / goodsId).
  asin         String
  sku          String?
  /// Id esterno (Amazon R3…, eBay FeedbackID, Etsy review id).
  externalId   String
  rating       Int
  /// eBay: POSITIVE / NEUTRAL / NEGATIVE. Null sulle recensioni a stelle.
  sentiment    String?
  title        String       @default("")
  body         String       @default("")
  author       String?
  /// Data come mostrata su Amazon (testo localizzato).
  dateLabel    String       @default("")
  /// Data recensione parsata dal testo Amazon, se riconoscibile.
  reviewedAt   DateTime?    @db.Date
  /// Paese di provenienza del recensore (ISO), se diverso o se le recensioni sono aggregate.
  originCountryCode String?
  /// Presa visione: le recensioni nuove restano false fino a conferma in UI.
  viewed       Boolean      @default(false)
  verified     Boolean      @default(false)
  capturedAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  consoleNotifications ConsoleNotification[]

  @@unique([channel, externalId], map: "StoreCustomerReview_ext_key")
  @@index([asin, storeKey, capturedAt], map: "StoreCustomerReview_asin_store")
  @@index([viewed, reviewedAt], map: "StoreCustomerReview_viewed_date")
  @@schema("product")
}

/// Snapshot giornaliero di titolo, bullet, descrizione e media per SKU × paese.
/// Il cron/import popola queste righe: la UI legge da qui invece di richiamare il marketplace.
model StoreListingContentSnapshot {
  id          String       @id @default(cuid())
  channel     StoreChannel
  storeKey    String
  countryCode String
  sku         String
  /// Id listing del marketplace (ASIN / ItemID / listing_id / goodsId).
  asin        String?
  capturedAt  DateTime     @db.Date
  title       String       @default("")
  description String       @default("")
  /// Array JSON di stringhe (punti elenco Amazon, o vuoto sugli altri canali).
  bulletPoints Json
  /// Array JSON di URL immagine.
  productImages Json
  /// Metadati qualità per eBay/Etsy/Temu (tag, specifics, listingId, conteggi foto).
  qualityMeta Json?
  mainImageWidth  Int?
  mainImageHeight Int?
  hasVideo    Boolean      @default(false)
  hasAplus    Boolean      @default(false)
  /// Data di pubblicazione Amazon (date_first_available o createdDate listing).
  publishedAt DateTime?    @db.Date
  /// Categoria Amazon (display group / browse root).
  amazonCategory    String?
  amazonCategoryKey String?
  /// Sottocategoria Amazon (browse node foglia).
  amazonSubcategory    String?
  amazonSubcategoryKey String?
  ean String?
  /// Collegamento a inventory.Product (stesso ASIN, EAN o SKU).
  inventoryProductId   String? @db.Uuid
  inventoryProductName String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, sku, capturedAt], map: "StoreListingContent_day_key")
  @@index([sku, capturedAt], map: "StoreListingContent_sku_date")
  @@index([asin, storeKey, capturedAt], map: "StoreListingContent_asin_store_date")
  @@index([inventoryProductId], map: "StoreListingContent_inventory_product")
  @@schema("product")
}

/// Snapshot giornaliero dello stato Amazon (BUYABLE / DISCOVERABLE) per SKU × paese.
/// Amazon non espone lo storico di inattività: lo ricostruiamo da queste osservazioni.
model StoreListingActivitySnapshot {
  id             String       @id @default(cuid())
  channel        StoreChannel
  storeKey       String
  countryCode    String
  sku            String
  asin           String?
  capturedAt     DateTime     @db.Date
  /// Istante reale dell'osservazione (orario dell'import).
  observedAt     DateTime     @db.Timestamptz(6)
  isPublished    Boolean
  isBuyable      Boolean
  isDiscoverable Boolean
  /// Stati Amazon grezzi (`BUYABLE`, `DISCOVERABLE`).
  statuses       String[]     @default([])
  quantity       Int?
  /// `lastUpdatedDate` Amazon sul listing, se presente.
  amazonUpdatedAt DateTime?   @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, sku, capturedAt], map: "StoreListingActivity_day_key")
  @@index([sku, storeKey, capturedAt], map: "StoreListingActivity_sku_date")
  @@schema("product")
}

/// Periodo in cui il listing non era acquistabile in un paese.
/// `endedAt` null = ancora inattivo al momento dell'ultima osservazione.
model StoreListingInactivityPeriod {
  id              String       @id @default(cuid())
  channel         StoreChannel
  storeKey        String
  countryCode     String
  sku             String
  asin            String?
  startedAt       DateTime     @db.Timestamptz(6)
  endedAt         DateTime?    @db.Timestamptz(6)
  /// NOT_BUYABLE | NOT_DISCOVERABLE | OUT_OF_STOCK | ABSENT
  reason          String
  statuses        String[]     @default([])
  quantity        Int?
  amazonUpdatedAt DateTime?    @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  consoleNotifications ConsoleNotification[]

  @@index([channel, storeKey, sku, startedAt], map: "StoreListingInactivity_sku_start")
  @@index([sku, storeKey, endedAt], map: "StoreListingInactivity_open")
  @@schema("product")
}

/// Job resumable per l'import giornaliero qualità (bottone UI o cron).
model StoreQualityDailyJob {
  id                 String            @id @default(cuid())
  channel            StoreChannel
  capturedAt         DateTime          @db.Date
  /// listings | extras | reviews | refresh | refresh_reviews | done
  phase              String            @default("listings")
  nextAmazonPage     Int               @default(1)
  /// Offset nella coda SKU extra (inventory / vendite / snapshot precedenti).
  nextExtraOffset    Int               @default(0)
  processedListings  Int               @default(0)
  processedReviews   Int               @default(0)
  totalListings      Int               @default(0)
  status             StoreReportStatus @default(REQUESTED)
  lastMessage        String?
  errorMessage       String?
  importedAt         DateTime?         @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([channel, capturedAt], map: "StoreQualityDailyJob_day_key")
  @@index([status, capturedAt], map: "StoreQualityDailyJob_status_idx")
  @@schema("product")
}

/// Prompt JSON modificabile per i suggerimenti OpenAI sulla scheda qualità.
model QualityAiPrompt {
  id String @id @default(cuid())
  /// Chiave logica, es. `listing-content-suggest`.
  key String @unique
  /// JSON: model, system, instructions.
  prompt Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@schema("product")
}

/// Versione di titolo, bullet e descrizione per SKU × paese.
/// `published` = inviata ad Amazon; il live può tardare giorni.
model QualityListingContentVersion {
  id          String       @id @default(cuid())
  channel     StoreChannel
  storeKey    String
  countryCode String
  sku         String
  version     Int
  title       String       @default("")
  description String       @default("")
  /// Array JSON di stringhe (punti elenco).
  bulletPoints Json
  /// True se questa versione è stata inviata ad Amazon.
  published   Boolean      @default(false)
  publishedAt DateTime?    @db.Timestamptz(6)
  /// deepl | chatgpt | manual
  source      String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([channel, storeKey, sku, version], map: "QualityListingContentVer_ver_key")
