  id             String   @id @default("default")
  /// Sotto questa % il margine è basso (rosso).
  lowMaxPercent  Decimal  @default(30) @db.Decimal(5, 2)
  /// Da questa % in su il margine è buono (verde).
  goodMinPercent Decimal  @default(45) @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@schema("product")
}

